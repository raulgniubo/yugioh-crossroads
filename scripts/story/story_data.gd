		{"shot": {"on": Vector3(0, 0, 26), "look_h": 4.0, "ang": [0.3, -0.15], "d": [24.0, 16.0], "h": [13.0, 3.5], "t": 7.0},
			"cap": "White towers. A road with light running through it. And over all of it a highway ring, hanging in the sky like a halo."},
		{"s": "lumen", "t": "New Domino! Everybody here duels on Duel Runners, flat out, on that ring. You should be able to hear this city from a mile away.", "do": "cheer"},
		{"s": "player", "t": "I can hear my own footsteps.", "do": "checkout"},
		{"s": "lumen", "t": "Yeah. That's the bad part. *bzzt* The crack is close. Up the boulevard, I think. Probably.", "cam": "close"},
		{"goal": "Walk up the boulevard to the plaza", "at": Vector3(0, 0, 21.5), "r": 3.0, "how": "Straight ahead, north, to the big screen."},
		{"s": "", "t": "A crowd stands under the big screen with their heads tipped back. The screen plays one finish line, one checkered flag, again and again.", "cam": "wide"},
		{"actor": "jack", "at": Vector3(2.6, 0, 18.6), "from": Vector3(3.0, 0, 2.0), "face": "player"},
		{"act": "jack", "emote": "!", "wait": 0.9, "cam": "low"},
		{"s": "jack", "t": "You. You are moving. Do you know how rare that has become in my city?", "cam": "low"},
		{"s": "player", "t": "Your city?", "emote": "?"},
		{"s": "jack", "t": "Jack Atlas. The King. Forty-two wins, and a stadium that used to shake when I walked out.", "anim": "cheer", "cam": "low"},
		{"s": "jack", "t": "Three nights ago they stopped cheering. They stand here and watch my greatest victory on a loop. I did not give anyone permission to live in it.", "do": "chat"},
		{"s": "lumen", "t": "(Hollows. A whole plaza. And he's mostly upset that nobody is clapping.)", "cam": "close"},
		{"choice": [["We can wake them up.", "open"], ["Sounds lonely at the top.", "direct"]]},
		{"if": "open", "s": "jack", "t": "We. Listen to that. A King does not ask for help.", "cam": "low"},
		{"if": "direct", "s": "jack", "t": "...Careful. A King does not explain himself.", "cam": "low"},
