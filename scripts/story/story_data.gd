	"ch4": [
		{"scene": {"district": "heartland", "inside": "", "pos": Vector3(0, 0, 33), "yaw": 0.0, "tod": "day", "music": "heartland"},
			"chapter": "Chapter 4", "title": "The Brightest Day", "sub": "Heartland City. Festival week."},
		{"actor": "lumen", "at": Vector3(1.0, 0, 32.2), "face": "player", "spirit": true},
		{"shot": {"on": Vector3(0, 0, 14), "look_h": 3.0, "ang": [0.35, -0.2], "d": [30.0, 20.0], "h": [13.0, 4.5], "t": 7.0},
			"cap": "Heartland City. Balloons, music, and a monorail full of people waving at nobody in particular."},
		{"s": "", "t": "Nobody here is frozen. That is the strange part.", "cam": "wide"},
		{"s": "lumen", "t": "It's... fine? Everybody is moving. Everybody is HAPPY. *bzzt* Why does that scare me more?", "emote": "?", "do": "checkout"},
		{"s": "player", "t": "You said he was already here.", "cam": "close"},
		{"s": "lumen", "t": "He is. I can feel him. It's like standing next to a door I've walked through before.", "cam": "close"},
		{"actor": "yuma", "at": Vector3(-1.9, 0, 30.4), "from": Vector3(-17, 0, 23), "face": "player", "run": true},
		{"s": "yuma", "t": "Out of the way out of the way I'm late I'm SO late I'm... whoa!", "emote": "!", "do": "stomp"},
		{"s": "yuma", "t": "Sorry! Sorry. Hey, is that a duel disk? You're a duelist! I've never seen you at the festival!", "do": "wave"},
		{"s": "player", "t": "We just got here.", "react": {"lumen": "..."}},
		{"s": "yuma", "t": "Then you picked the best day of the whole year! Tonight is the Festival final, at the foot of the tower. The entire city shows up. I'm in it!", "anim": "cheer"},
		{"s": "yuma", "t": "I'm also late for it. But I never, ever turn down a duel. One quick one, to warm up? I'm feeling the flow!", "do": "cheer", "cam": "close"},
		{"choice": [["\"You're on.\"", "eager"], ["\"Aren't you late?\"", "tease"]]},
		{"if": "eager", "s": "yuma", "t": "YES! I knew I liked you!"},
		{"if": "tease", "s": "yuma", "t": "Extremely! That's what makes it exciting!"},
		{"duel": {"opponent": "yuma", "opp_deck": "yuma", "fallback": "joey", "lose_ok": true, "difficulty": 2, "field": "heartland"}},
		{"if": "won", "s": "yuma", "t": "I lost! That was AWESOME! Do it again! No wait, the final. After the final, do it again!", "anim": "cheer"},
		{"if": "lost", "s": "yuma", "t": "I won! But you almost had me three separate times, I counted! You have to come to the final!", "anim": "cheer"},
		{"s": "yuma", "t": "You know what? You're my friend now. That's how it works. I just decided.", "cam": "close", "do": "wave", "react": {"lumen": "♪"}},
		{"bond": "Yuma Tsukumo", "card": 84013237, "text": "A fifth blank card fills in: an echo of Yuma getting back up, one more time than he was knocked down. It is in your collection now."},
		{"s": "yuma", "t": "Everyone I know is going to be there tonight. All at once, all cheering. It's going to be the best day EVER.", "anim": "cheer"},
		{"s": "lumen", "t": "({player}. He said best day. A whole city, one moment, all at the same time. THAT is what the Curator has been saving room for.)", "cam": "close", "react": {"player": "!"}},
		{"actor": "kairo", "at": Vector3(2.8, 0, 30.6), "from": Vector3(16, 0, 23), "face": "player"},
		{"act": "kairo", "emote": "...", "wait": 0.9, "cam": "low"},
		{"s": "kairo", "t": "The spirit is right. For once.", "cam": "low", "react": {"lumen": "#", "yuma": "?"}},
		{"s": "player", "t": "Kairo.", "cam": "close"},
		{"s": "kairo", "t": "I'm not here to fight you. He isn't taking people one at a time anymore. When that final ends and this whole city cheers at once, Vellum frames it. All of it. Everyone.", "do": "chat"},
		{"s": "player", "t": "Why tell us?"},
		{"s": "kairo", "t": "Because I went to the museum and stood in front of my brother. He looked straight through me. Smiling.", "cam": "close", "emote": "..."},
		{"choice": [["\"Then help us stop it.\"", "m_kairo_ally"], ["\"Why should I trust you now?\"", "m_kairo_doubt"]]},
		{"if": "m_kairo_ally", "s": "kairo", "t": "...You make it sound simple. Fine. Maybe it is.", "cam": "close"},
		{"if": "m_kairo_doubt", "s": "kairo", "t": "You shouldn't. I wouldn't. Watch what I do instead of what I say.", "cam": "close"},
		{"s": "kairo", "t": "Vellum hung his frame at the foot of the tower, north end of the plaza. He will have someone watching the way in. I'll go around the back.", "do": "chat"},
		{"s": "yuma", "t": "I understood about half of that and I am completely in! Come on, the tower's this way!", "anim": "cheer"},
		{"move": "kairo", "to": Vector3(22, 0, 14), "run": true},
		{"move": "yuma", "to": Vector3(-3.2, 0, -12.5), "run": true, "face": 0.0},
		{"goal": "Cross the plaza toward Heartland Tower", "at": Vector3(0, 0, -11.0), "r": 3.0, "how": "North, past the fountain and the duel ring. The tower is the tall one straight ahead.", "hint": "Yuma ran north, past the fountain. The tower is straight ahead!"},
		{"gone": "kairo"},
		{"actor": "kite", "at": Vector3(1.4, 0, -15.0), "from": Vector3(11, 0, -22), "face": "player"},
		{"act": "kite", "emote": "...", "wait": 0.9, "cam": "low"},
		{"s": "kite", "t": "That is far enough.", "cam": "low", "react": {"yuma": "!"}},
		{"s": "yuma", "t": "Kite! They're with me!", "do": "wave"},
		{"s": "kite", "t": "Everyone is with you, Yuma. That is the trouble with you.", "cam": "close"},
		{"s": "kite", "t": "A stranger with a deck that hums, on the same day a man in grey starts measuring my city for a frame. I do not believe in coincidence.", "cam": "low"},
		{"s": "lumen", "t": "We're trying to STOP the man in grey!", "emote": "#"},
		{"s": "kite", "t": "Then prove it the only way I trust. My little brother is in that crowd tonight. If you are lying, you will not get past me.", "cam": "close", "anim": "cheer"},
		{"duel": {"opponent": "kite", "opp_deck": "kite", "fallback": "kaiba", "lose_ok": false, "difficulty": 2, "field": "heartland"}},
		{"act": "kite", "emote": "...", "wait": 1.0, "cam": "close"},
		{"s": "kite", "t": "...Your deck does not take. It gives back. I can see it now.", "cam": "close"},
		{"s": "kite", "t": "He is under the tower. Go. I will get my brother away from the plaza. If you are too slow, I will hold you personally responsible.", "do": "chat"},
		{"move": "kite", "to": Vector3(18, 0, -4), "run": true},
		{"s": "yuma", "t": "That's Kite for 'good luck'. He likes you!", "do": "scratch"},
		{"tod": "sunset"},
		{"gone": "kite"},
		{"move": "yuma", "to": Vector3(0.6, 0, -19.6), "run": true, "face": 0.0},
		{"goal": "Go to the foot of Heartland Tower", "at": Vector3(3.0, 0, -21.0), "r": 3.0, "how": "Keep going north. The tower entrance is right ahead."},
		{"actor": "vellum", "at": Vector3(3.4, 0, -26.5), "face": "player", "coat": Color(0.5, 0.5, 0.56)},
		{"shot": {"on": "vellum", "face": [0.5, 0.1], "d": [6.5, 3.6], "h": [0.8, 1.5], "t": 6.5}, "music": "duel_dark",
			"cap": "A man in a grey coat is hanging something in the air above the plaza. A frame the size of a city block, with nothing in it yet."},
		{"s": "vellum", "t": "Ah. The one who keeps un-filing my records. Vellum. Head Archivist.", "cam": "low"},
		{"s": "vellum", "t": "Do you know how many people are happy at the same moment, on an ordinary day? Almost none. Tonight, in eleven minutes, this entire city will be. I have waited years for a day like this.", "do": "chat"},
		{"s": "player", "t": "And then they stay in it forever.", "cam": "close"},
		{"s": "vellum", "t": "And then they never have a worse one. You say that as if it were a punishment.", "cam": "close"},
		{"s": "lumen", "t": "It IS one! A day isn't a day if tomorrow never comes!", "emote": "#", "do": "cheer"},
		{"s": "vellum", "t": "...Well. Hello. He told me you would look different. He has kept your plinth dusted, you know. Every single morning.", "cam": "close", "react": {"lumen": "?", "player": "?"}},
		{"s": "lumen", "t": "My WHAT?", "cam": "close"},
		{"s": "vellum", "t": "Filed under: later. First, the trespasser.", "cam": "low", "anim": "cheer"},
		{"duel": {"opponent": "vellum", "opp_deck": "vellum", "fallback": "yugi", "lose_ok": false, "difficulty": 3, "field": "heartland", "opp_lp": 10000,
			"rule": "Vellum starts with 10000 Life Points. An archivist never comes with an empty shelf."}},
		{"s": "vellum", "t": "An error in the record. That is... not possible.", "do": "stomp", "cam": "close"},
		{"s": "", "t": "Above the plaza the empty frame cracks down the middle and comes apart like wet paper.", "fx": "flash", "cam": "wide"},
		{"s": "yuma", "t": "You DID it! Did you see that?! That was the best duel I've ever seen! This is the best day EVER!", "anim": "cheer", "cam": "close"},
		{"fx": "freeze"},
		{"gone": "yuma"},
		{"actor": "yuma", "at": Vector3(0.6, 0, -19.6), "face": 0.6, "hollow": true},
		{"music": "museum"},
		{"shot": {"on": "yuma", "face": [0.7, 0.2], "d": [4.5, 2.4], "h": 1.6, "t": 6.0}, "sfx": "banish",
			"cap": "Yuma stops with both fists in the air. He is still smiling."},
		{"s": "player", "t": "Yuma? ...YUMA!", "cam": "close", "emote": "!"},
		{"actor": "curator", "at": Vector3(3.6, 0, -28.6), "from": Vector3(3.6, 0, -32.0), "face": "player", "coat": WHITE, "pale": 0.55},
		{"gone": "vellum"},
		{"shot": {"on": "curator", "face": [0.3, 0.0], "d": [6.0, 3.2], "h": [0.9, 1.6], "t": 6.0},
			"cap": "The man in the white coat. He looks like somebody's grandfather. He looks tired."},
		{"s": "curator", "t": "Thank you. I could not have framed this one myself. It needed a new friend in it, and I have not been able to make one of those in a very long time.", "cam": "close"},
		{"s": "player", "t": "You used us.", "cam": "close"},
		{"s": "curator", "t": "Vellum's frame was never meant for the city. It was meant to keep you here long enough to give that boy the best day of his life. You did. It is beautiful work.", "do": "chat"},
		{"actor": "kairo", "at": Vector3(6.8, 0, -24.6), "from": Vector3(16, 0, -19), "face": "curator", "run": true},
		{"s": "kairo", "t": "LET HIM GO!", "cam": "low", "emote": "#"},
		{"s": "curator", "t": "Kairo. You were supposed to be proud of your brother. Not jealous of him.", "cam": "close"},
		{"fx": "shake"},
		{"move": "kairo", "to": Vector3(8.2, 0, -22.6), "face": "curator"},
		{"s": "kairo", "t": "My deck... it's blank. Every card. He blanked my deck.", "cam": "close", "emote": "..."},
		{"turn": "curator", "to": "lumen"},
		{"s": "curator", "t": "And you. Exhibit Zero. You have been gone a very long time.", "cam": "close", "react": {"lumen": "!"}},
		{"s": "lumen", "t": "I don't... *bzzt* I don't know you! I don't! ...Aurel?", "cam": "close", "react": {"player": "!"}},
		{"s": "curator", "t": "There. You see? You do.", "cam": "close"},
		{"fx": "flash"},
		{"gone": "lumen"},
		{"s": "", "t": "The light that has floated at your shoulder since the very first night folds itself into his hand, like a card going back into a deck.", "fx": "shake", "cam": "wide"},
		{"s": "player", "t": "LUMEN!", "cam": "close", "emote": "!"},
		{"s": "curator", "t": "Come and see her, if you like. Everyone is welcome in my museum. And nobody ever has to leave.", "cam": "low"},
		{"fx": "rift", "at": Vector3(3.6, 0, -30.6)},
		{"move": "curator", "to": Vector3(3.6, 0, -30.4), "face": PI},
		{"shot": {"on": Vector3(3.6, 0, -30.6), "look_h": 2.0, "ang": [0.5, 0.0], "d": [8.0, 11.0], "h": [1.6, 3.0], "t": 5.0},
			"cap": "He steps through. The light closes behind him without a sound."},
		{"gone": "curator"},
		{"fx": "rift_close"},
		{"s": "", "t": "The plaza is silent. Thousands of people, every one of them smiling up at a sky with nothing in it.", "cam": "wide"},
		{"s": "kairo", "t": "...I know where his door is. It was never in any of these cities.", "cam": "close"},
		{"s": "kairo", "t": "It is wherever the first memory was. Wherever that deck of yours came from.", "cam": "close"},
		{"s": "player", "t": "Grandpa's shop.", "cam": "close", "emote": "!"},
