		{"scene": {"district": "newdomino", "inside": "", "pos": Vector3(0, 0, 42), "yaw": 0.0, "tod": "day", "music": "city"},
			"chapter": "Chapter 3", "title": "The Last Lap", "sub": "New Domino City. The cleanest streets you have ever seen."},
		{"actor": "lumen", "at": Vector3(1.0, 0, 41.2), "face": "player", "spirit": true},
		{"actor": "office_worker", "at": Vector3(-2.8, 0, 16.4), "face": PI, "hollow": true},
