	"ch5": [
		{"scene": {"district": "domino", "inside": "kame", "pos": SHOP + Vector3(1.2, 0, 1.6), "yaw": 0.0, "tod": "night", "music": "memory"},
			"chapter": "Final Chapter", "title": "The Museum Where Nothing Ends", "sub": "Home. After closing."},
		{"actor": "grandpa", "at": SHOP + Vector3(3.4, 0, -2.5), "face": "player"},
		{"actor": "kairo", "at": SHOP + Vector3(-0.6, 0, 2.6), "face": "grandpa"},
		{"shot": {"on": "grandpa", "face": [0.6, 0.25], "d": [5.0, 3.0], "h": [2.0, 1.5], "t": 6.0},
			"cap": "The shop is closed. The light over the counter is still on, the way it is when he is waiting up for someone."},
		{"s": "grandpa", "t": "You're back. And the little light is not with you.", "cam": "close"},
		{"s": "player", "t": "He took her. He called her Exhibit Zero. And she called him Aurel.", "cam": "close"},
		{"act": "grandpa", "emote": "...", "wait": 1.4, "cam": "close"},
		{"s": "grandpa", "t": "Aurel Thane. I have not said that name out loud in fifty years.", "cam": "close"},
		{"s": "grandpa", "t": "Sit down. Both of you. I should have told you this the night I gave you the deck.", "do": "chat"},
		{"echo": "The Best Final", "sub": "Solomon's memory. Fifty years ago, and last winter."},
		{"scene": {"district": "domino", "inside": "kame", "pos": SHOP + Vector3(-4.6, 0, -2.0), "yaw": 0.0, "tod": "sunset"}},
		{"actor": "boy_sol", "at": TABLE + Vector3(-1.5, 0, 0), "face": 1.57},
		{"actor": "boy_aurel", "at": TABLE + Vector3(1.5, 0, 0), "face": -1.57},
		{"shot": {"on": TABLE, "look_h": 1.0, "ang": [2.6, 3.2], "d": [5.2, 4.0], "h": [2.2, 1.7], "t": 6.5},
			"cap": "We made that deck together, Aurel and I. Every card drawn by hand. The summer we finished it we played one last duel, for a trophy his father won at a fair."},
		{"shot": {"on": "boy_aurel", "face": [-0.5, -0.2], "d": 2.3, "h": 1.45, "look_h": 1.2, "t": 5.5},
			"cap": "It was the best duel either of us ever played. Down to the last card. Half the shop was standing on chairs."},
		{"s": "boy_aurel", "t": "Whatever happens, promise me we will remember this one. Exactly the way it was.", "keep": true},
		{"s": "boy_sol", "t": "Who could ever forget this?", "shot": {"on": "boy_sol", "face": [0.5, 0.2], "d": 2.3, "h": 1.45, "look_h": 1.2, "t": 5.0}},
		{"move": "boy_aurel", "to": SHOP + Vector3(0.4, 0, 3.6)},
		{"shot": {"on": "boy_sol", "face": [0.2, -0.3], "d": [2.6, 4.5], "h": [1.5, 2.2], "t": 6.0},
			"cap": "His family moved away that autumn. We wrote for a while. Then we didn't."},
		{"scene": {"district": "domino", "inside": "", "pos": DOOR + Vector3(14, 0, 16), "yaw": 0.0, "tod": "night"}},
		{"actor": "aurel", "at": DOOR + Vector3(0.4, 0, 1.3), "face": PI, "coat": WHITE, "pale": 0.3},
		{"shot": {"on": "aurel", "ang": [0.5, 0.15], "d": [9.0, 6.0], "h": [2.6, 1.8], "t": 7.0},
			"cap": "Last winter an old man stood outside this window for an hour. I took him for a customer who had lost his nerve."},
		{"shot": {"on": "aurel", "face": [0.7, 0.4], "d": [3.0, 2.2], "h": 1.6, "t": 7.0},
			"cap": "He had come to ask me one question. Who won. He could not remember anymore. And he was too afraid that I could not either."},
		{"cap": "So he went away and built a place where nothing is ever forgotten. And the first thing he hung in it was that duel."},
		{"echo": false},
		{"scene": {"district": "domino", "inside": "kame", "pos": SHOP + Vector3(1.2, 0, 1.6), "yaw": 0.0, "tod": "night"}},
