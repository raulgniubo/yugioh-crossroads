		{"duel": {"opponent": "vesper", "opp_deck": "kalin", "fallback": "kairo", "lose_ok": false, "difficulty": 2, "field": "satellite", "turbo": true}},
		{"s": "", "t": "The white runner fishtails. The shard tears loose from its housing and bursts over the junkyard like fireworks.", "fx": "flash", "cam": "wide"},
		{"s": "lumen", "t": "Another one! And this memory is hers!", "emote": "!", "cam": "close"},
		{"echo": "One Clean Lap", "sub": "Vesper's memory. Satellite, six years ago.", "tint": Color(1.0, 0.84, 0.7)},
		{"scene": {"district": "satellite", "inside": "", "pos": Vector3(-24, 0, 36), "yaw": 0.0, "tod": "sunset"}},
		{"actor": "vesper", "at": Vector3(0, 0, 27.5), "face": 0.0},
		{"shot": {"on": "vesper", "face": [0.9, 0.3], "d": [8.0, 4.5], "h": [3.0, 1.7], "t": 6.5},
			"cap": "A girl from Satellite, on a runner she built out of three dead ones. One lap of the old ring. The fastest anyone down here had ever seen."},
		{"s": "vesper", "t": "Did you time it? Somebody tell me you timed it!", "keep": true, "anim": "cheer"},
		{"shot": {"on": "vesper", "face": [-0.3, -0.6], "d": 2.4, "h": 1.5, "t": 5.5}, "cap": "The engine seized the next morning. There was never money for another one."},
		{"actor": "curator", "at": Vector3(1.9, 0, 28.6), "from": Vector3(9, 0, 34), "face": "vesper", "coat": WHITE, "pale": 0.55},
		{"shot": {"on": Vector3(0.9, 0, 28), "look_h": 1.4, "ang": [0.3, -0.2], "d": [6.0, 4.2], "h": 1.7, "t": 6.0},
			"cap": "She stood at the fence every race day after that. One day a man in a white coat stood next to her."},
		{"s": "curator", "t": "You have already ridden your best lap. Why stand here and watch other people ride worse ones? Come and look after the perfect ones with me.", "keep": true},
