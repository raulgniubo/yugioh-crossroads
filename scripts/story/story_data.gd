		{"actor": "student_boy", "at": Vector3(1.5, 0, 19.6), "face": "player"},
		{"s": "vesper", "t": "...It's loud again. I had forgotten how loud it was.", "cam": "close", "emote": "..."},
		{"s": "vesper", "t": "Tell Kairo he was right to wonder. Do not tell him I said so.", "cam": "close"},
		{"move": "vesper", "to": Vector3(-22.0, 0, 34.0), "run": true},
