				{"s": "player", "t": "Akiza says the plaza is holding.", "cam": "close"},
				{"s": "yusei", "t": "...I wasn't worried.", "emote": "...", "cam": "close"},
				{"s": "yusei", "t": "Give me until the light goes. Then I'll show you how to stay on it. Meet me at the old start line."}]},
		]},
