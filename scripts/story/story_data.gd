		{"title": "The King's errand", "open": ["satellite"], "hide": ["nd_rider", "sat_vendor", "night_newdomino", "night_satellite"],
			"cast": [{"actor": "office_worker", "at": Vector3(-2.8, 0, 16.4), "face": PI, "hollow": true},
