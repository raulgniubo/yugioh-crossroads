		{"actor": "yusei", "at": Vector3(2.4, 0, 28.6), "from": Vector3(3.6, 0, 23.6), "face": "vesper"},
		{"s": "yusei", "t": "A lap you can't ride again isn't a lap. It's a photograph.", "cam": "close"},
		{"act": "vesper", "emote": "...", "wait": 1.0, "cam": "close"},
		{"s": "vesper", "t": "Kairo said you would talk like this. He has gone soft. He asks questions now. I don't ask. I collect.", "cam": "close"},
