		{"shot": {"on": Vector3(0, 0, 26), "look_h": 4.0, "ang": [0.3, -0.15], "d": [24.0, 16.0], "h": [13.0, 3.5], "t": 7.0},
			"cap": "White towers. A road with light running through it. And over all of it a highway ring, hanging in the sky like a halo."},
		{"s": "lumen", "t": "New Domino! Everybody here duels on Duel Runners, flat out, on that ring. You should be able to hear this city from a mile away.", "do": "checkout"},
		{"s": "player", "t": "I can hear my own footsteps.", "cam": "close"},
		{"s": "lumen", "t": "Yeah. That's the bad part. *bzzt* The crack is close. Up the boulevard, I think. Probably.", "emote": "..."},
		{"goal": "Walk up the boulevard to the plaza", "at": Vector3(0, 0, 21.5), "r": 3.0, "how": "Straight ahead, north, to the big screen."},
		{"s": "", "t": "A crowd stands under the big screen with their heads tipped back. The screen plays one finish line, one checkered flag, again and again.", "cam": "wide"},
		{"actor": "jack", "at": Vector3(2.6, 0, 18.6), "from": Vector3(3.0, 0, 2.0), "face": "player"},
		{"act": "jack", "emote": "!", "wait": 0.9, "cam": "low"},
		{"s": "jack", "t": "You. You are moving. Do you know how rare that has become in my city?", "cam": "low"},
		{"s": "player", "t": "Your city?"},
		{"s": "jack", "t": "Jack Atlas. The King. Forty-two wins, and a stadium that used to shake when I walked out.", "anim": "cheer", "react": {"lumen": "!"}},
		{"s": "jack", "t": "Three nights ago they stopped cheering. They stand here and watch my greatest victory on a loop. I did not give anyone permission to live in it.", "cam": "close"},
		{"s": "lumen", "t": "(Hollows. A whole plaza. And he's mostly upset that nobody is clapping.)", "react": {"player": "..."}},
		{"choice": [["We can wake them up.", "open"], ["Sounds lonely at the top.", "direct"]]},
		{"if": "open", "s": "jack", "t": "We. Listen to that. A King does not ask for help. A King holds an audition."},
		{"if": "direct", "s": "jack", "t": "...Careful. A King does not explain himself. A King holds an audition."},
		{"s": "jack", "t": "Duel me. If you bore me, you leave my city by the same road you came in on.", "cam": "low", "anim": "cheer"},
		{"duel": {"opponent": "jack", "opp_deck": "jack", "lose_ok": false, "difficulty": 2, "field": "kaibacorp"}},
		{"act": "jack", "do": "stomp", "emote": "#", "wait": 1.1, "cam": "close"},
		{"s": "jack", "t": "Hmph. Adequate. More than adequate. Do not repeat that.", "cam": "close"},
		{"s": "jack", "t": "Every night since this began, a white runner laps the ring. No plate. No rider I know. It crosses the line and my city goes one shade quieter.", "do": "chat"},
		{"s": "player", "t": "Then we catch it.", "cam": "close"},
		{"s": "jack", "t": "I would run it down myself. My runner is... being serviced.", "do": "scratch", "react": {"lumen": "?"}},
		{"s": "jack", "t": "The man you want lives below, in Satellite. Yusei Fudo. He builds runners out of scrap, and one of them beat mine. Once. One time.", "cam": "close"},
		{"s": "jack", "t": "Take the Highway Gate. Tell him the King sent you. He will find that funnier than he should.", "do": "wave"},
		{"move": "jack", "to": Vector3(3.0, 0, 2.0), "face": PI},
