		{"actor": "lumen", "at": STAGE + Vector3(2.0, 0, 6.4), "face": "player", "spirit": true},
		{"s": "nico", "t": "TWO TO ONE! DUEL ACADEMY TAKES THE MATCH! The Wall had a door, and the bench found it! I get one scream per match and that was it!", "do": "cheer", "cam": "wide"},
		{"s": "irina", "t": "Boreal does not celebrate. We count. Then we go home.", "cam": "low"},
		{"s": "irina", "t": "Three questions, and you answered. I will bring better ones.", "cam": "close"},
		{"s": "player", "t": "Bring them."},
		{"s": "lumen", "t": "Look at the Doctor. Under the desk. He is clapping. Very small claps.", "cam": "close", "emote": "♪"},
		{"s": "nico", "t": "Doctor Crowler! Is that applause? Under the desk?", "emote": "!"},
