		# ---- Lumen's card
		{"s": "lumen", "t": "He said you had no team.", "cam": "close", "emote": "..."},
		{"s": "lumen", "t": "I was furious for that whole duel. I was proud for that whole duel. I did not know I could hold both. So I got bigger.", "cam": "close", "do": "stomp"},
