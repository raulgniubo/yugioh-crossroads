		{"s": "bastion", "t": "You sat through all forty pages. I had hoped that would make this harder to calculate. It did not.", "if": "m_ch8_file"},
		{"s": "bastion", "t": "You asked me for one page once. This is one page too. I dislike it just as much.", "unless": "m_ch8_file"},
		{"s": "sato", "t": "Then run it a fifth. On the field. At sunset.", "cam": "low"},
		{"s": "sato", "t": "Against the reserve. Your model has never once been right about that one.", "cam": "close"},
		{"s": "sato", "t": "And you. Morel's seat is open and the island has noticed. Walk around. Listen. Bring what you hear to the field.", "do": "chat"},
		{"cine": false},
		# ---- your move: the island, with a seat open
		{"aim": "Hold the team together", "in": "academy", "hide": ["ac_vendor"],
			"cast": [{"actor": "alexis", "at": PRACTICE + Vector3(-1.6, 0, 2.2), "face": 0.0}, {"actor": "syrus", "at": RED_OUT + Vector3(4.0, 0, 2.2), "face": 1.57}, {"actor": "mika", "at": SCHOOL + Vector3(1.8, 0, 9.4), "face": 3.14}, {"actor": "octavia", "at": BLUE_OUT + Vector3(0.0, 0, 0.0), "face": 0.0}],
			"tasks": [
			{"talk": "alexis", "at": PRACTICE + Vector3(-1.6, 0, 2.2), "face": 0.0, "optional": true, "label": "Talk to Alexis about Zane (practice fields, north-east of the plaza)", "from": "sato", "why": "She is carrying this team by herself. Ask her how heavy it is.", "merits": 10, "bond": "alexis", "say": [
				{"s": "alexis", "t": "I call the drills. Zane does them perfectly and goes home. I can run a practice. I cannot be captain with the captain standing right there.", "do": "chat"},
				{"s": "alexis", "t": "You knocked that night. He never mentioned it. He has also not locked that door since. I notice things too.", "if": "m_ch11_knock", "cam": "close"},
				{"s": "alexis", "t": "You left him the night. I thought it was wrong. I am less sure now. He came out by himself, at least.", "if": "m_ch11_wait", "cam": "close"},
				{"s": "player", "t": "Then do not be captain. Just keep him in the room."},
				{"s": "alexis", "t": "Keep him in the room. That is a low bar. ...This week I will take a low bar.", "emote": "♪"}]},
			{"talk": "syrus", "at": RED_OUT + Vector3(4.0, 0, 2.2), "face": 1.57, "optional": true, "label": "Ask Syrus about his brother (Red dorm, front yard)", "from": "alexis", "why": "Nobody knows Zane's silences better.", "merits": 10, "bond": "syrus", "say": [
				{"s": "syrus", "t": "He has started leaving his door unlocked. I checked. Three nights in a row.", "do": "chat"},
				{"s": "syrus", "t": "He does not come out. But it is unlocked.", "cam": "close"},
				{"s": "player", "t": "Did you go in?", "emote": "?"},
