		{"wait": 1.2},
		{"s": "vera", "t": "I should like to know how that is done.", "cam": "close", "emote": "..."},
		{"s": "bruno", "t": "You start by sitting down. There is a second pot. I brought it for somebody. I did not know who until now.", "cam": "low", "do": "wave"},
		{"s": "vera", "t": "Nobody has ever saved me a seat. I do not know the procedure.", "cam": "close"},
