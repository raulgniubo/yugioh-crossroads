		# ---- sunset: in front of the main building
		{"scene": {"district": "academy", "inside": "", "pos": SCHOOL + Vector3(0.4, 0, 6.0), "yaw": 3.14, "tod": "sunset", "music": "academy"},
			"title": "The Main Building", "sub": "Sunset. The team comes out together. Almost all of it."},
		{"actor": "alexis", "at": SCHOOL + Vector3(1.6, 0, 6.6), "face": "player"},
		{"actor": "bastion", "at": SCHOOL + Vector3(-1.8, 0, 4.0), "face": "player"},
		{"actor": "sato", "at": SCHOOL + Vector3(2.9, 0, 4.4), "face": "player"},
		{"actor": "nico", "at": SCHOOL + Vector3(1.8, 0, 9.4), "face": "player"},
		{"actor": "lumen", "at": SCHOOL + Vector3(1.4, 0, 8.6), "face": "player", "spirit": true},
		{"s": "nico", "t": "Two to one! I said it into a real microphone and it echoed. The second echo was better than the first.", "do": "cheer"},
		{"s": "bastion", "t": "One match played, one won. For the first time since I opened it, the League page of my file is pleasant to read.", "do": "chat"},
		{"s": "alexis", "t": "I lost mine. I am going to be poor company for an hour. After that I want that wall explained to me."},
		{"s": "sato", "t": "You lost to a wall none of us had seen. Now three of us have seen it. That is what a first match is for.", "cam": "close"},
		{"actor": "crane", "at": SCHOOL + Vector3(-4.4, 0, 10.6), "face": 0.0},
		{"actor": "dante", "at": SCHOOL + Vector3(-3.2, 0, 10.8), "face": 0.0},
		{"s": "lumen", "t": "Do not turn around fast. On the path to the pier. An umbrella. It is not raining.", "cam": "close", "emote": "!"},
		{"s": "lumen", "t": "It is the man who pays for the lights. And he is not looking at the building this time. He is looking at one person.", "cam": "close"},
		{"s": "nico", "t": "That is Dante. Why is Dante walking with him?", "emote": "?"},
		{"s": "sato", "t": "Silas does not come to watch matches. He comes to watch who walks out of them.", "cam": "low"},
		{"s": "player", "t": "The pin is still on the bench."},
