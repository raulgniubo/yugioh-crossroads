		{"s": "lumen", "t": "Echo! You named yourself after my cards. I am not crying. Spirits do not cry. *bzzt*", "if": "nick_echo"},
		{"s": "lumen", "t": "Good name. Mysterious. I would have picked something with more sparkle, but nobody asked me.", "unless": "nick_echo"},
		{"s": "nico", "t": "Echo! Fresh chalk on the wall!", "if": "nick_echo"},
		{"s": "nico", "t": "Static! Fresh chalk on the wall!", "if": "nick_static"},
		{"s": "nico", "t": "Ash! Fresh chalk on the wall!", "if": "nick_ash"},
		{"s": "moth", "t": "A new mask. Good. I was getting tired of beating the same four people."},
		{"s": "nico", "t": "That is the Moth. Your first candle, whenever you are ready. Knock on the door.", "do": "chat"},
		{"circle_end": 0},
	],
