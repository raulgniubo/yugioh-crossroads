		# with Alexis
		{"s": "alexis", "t": "You asked. People do not ask me to things. They assume somebody already did.", "if": "m_fest_alexis", "cam": "close"},
		{"s": "alexis", "t": "So for three years I watched these from the Blue balcony. It is a very good balcony. It is very far away.", "if": "m_fest_alexis", "do": "chat"},
		{"s": "alexis", "t": "Tell me about the Red kitchen. Is it true that nobody eats alone in there?", "if": "m_fest_alexis", "emote": "?"},
		{"s": "player", "t": "Nobody is allowed to.", "if": "m_fest_alexis"},
		{"s": "alexis", "t": "Next year I want a team where nobody eats alone. Not the captain either. Him least of all.", "if": "m_fest_alexis", "cam": "low"},
		{"s": "alexis", "t": "Hold yours next to mine. If they go up together, they stay together longer. I do not know that. I am deciding it.", "if": "m_fest_alexis", "cam": "close", "emote": "♪"},
		{"campus": {"bond": ["alexis", 2]}, "if": "m_fest_alexis"},
		# with Octavia
		{"s": "octavia", "t": "Six festivals patrolled. Not one lantern let go. I was always the one holding the clipboard.", "if": "m_fest_octavia", "cam": "close"},
