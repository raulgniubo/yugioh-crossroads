	"ac_ch13": [
		{"scene": {"district": "academy", "inside": "", "pos": DOCK + Vector3(0.3, 0, -9.0), "yaw": 3.14, "tod": "sunset", "music": "duel_tense", "away": true},
			"chapter": "Chapter 13", "title": "The Offer", "sub": "The pier, in the rain. You are not there yet."},
		{"campus": {"morning": true, "weekday": 6}},
		{"campus": {"part": 1}},
		{"cine": true},
		{"room": DOCK + Vector3(0, 0, -5.0), "r": 9.0},
		{"actor": "dante", "at": DOCK + Vector3(1.4, 0, -3.0), "face": -0.6},
		{"actor": "crane", "at": DOCK + Vector3(0, 0, -0.9), "face": "dante"},
		{"shot": {"on": DOCK + Vector3(0, 0, -2.0), "look_h": 1.4, "ang": [2.6, 3.5], "d": [9.0, 6.0], "h": [3.2, 1.9], "t": 6.5},
			"vo": ["crane", "You came. Good. I was not certain this island had left you a reason to walk this far in the rain."]},
		{"s": "crane", "t": "Stand under the umbrella. No? As you like. Pride keeps a man dry for about a minute.", "do": "chat"},
		{"s": "dante", "t": "You said one conversation. I am here. The boat is yours, I assume.", "cam": "low"},
		{"s": "crane", "t": "The boat, the lights in that arena, and the chair you did not sit in yesterday. I pay for a great deal on this island.", "cam": "close"},
		{"s": "crane", "t": "A full scholarship at Apex. The best deck money can build, built around you. And a team where nobody will ever ask you to play second.", "cam": "low"},
		{"s": "dante", "t": "And my father?", "cam": "close"},
		{"s": "crane", "t": "Your father's name opens doors. I am offering you one that does not have his name on it.", "cam": "close"},
		{"s": "dante", "t": "Everybody who has ever offered me anything wanted that name on the back of it."},
		{"s": "crane", "t": "I already have his signature on four contracts. I do not need a fifth. I need the young man who walked out of a League match rather than stand in a line.", "do": "chat"},
		{"s": "dante", "t": "That was not courage. I was angry.", "emote": "..."},
		{"s": "crane", "t": "At Apex we do not ask which it was. We ask whether you win.", "cam": "close"},
		{"s": "crane", "t": "Here. A number, and a boat that leaves tonight. With you, or with an empty seat. I have paid for both.", "cam": "low"},
		{"wait": 1.4},
		{"s": "dante", "t": "...Give it to me.", "cam": "low"},
		{"s": "crane", "t": "There. That was the hard part. Go and pack. Take your time. Nobody on this island is going to stop you.", "do": "chat"},
		{"s": "crane", "t": "That, I am afraid, is rather my point.", "cam": "close"},
		{"move": "dante", "to": DOCK + Vector3(0.3, 0, -8.6)},
		{"gone": "dante"},
		# ---- the Yellow dorm, a few minutes later
		{"scene": {"district": "academy", "inside": "dorm_yellow", "pos": YELLOW + Vector3(1.4, 0, 5.2), "yaw": 0.0, "tod": "sunset", "music": "shop"},
			"title": "The Yellow Dorm", "sub": "A few minutes later. Rain on every window."},
		{"actor": "bastion", "at": YELLOW + Vector3(-3.2, 0, -6.4), "face": "player"},
		{"actor": "ivo", "at": YELLOW + Vector3(3.0, 0, 2.4), "face": "player"},
		{"actor": "lumen", "at": YELLOW + Vector3(0.2, 0, 4.0), "face": "player", "spirit": true},
		{"s": "lumen", "t": "Rain since breakfast. I started counting the drops on your window. I lost my place at nine hundred.", "cam": "close"},
		{"s": "bastion", "t": "I have redrawn the lineup with four names. It does not divide. I have tried it three ways.", "do": "scratch"},
		{"s": "ivo", "t": "He was not at breakfast in Blue. He was not at lunch. I asked. Quietly.", "cam": "close"},
		{"actor": "nico", "at": YELLOW + Vector3(2.2, 0, 3.8), "face": "player", "from": YELLOW + Vector3(2.2, 0, 7.2), "run": true},
		{"s": "nico", "t": "The pier! Dante! A bag! A boat with its lights on! And the man with the umbrella is standing there, perfectly dry!", "cam": "close", "emote": "!"},
		{"s": "nico", "t": "I ran the whole way. I am not narrating. This is just how I breathe after I run.", "do": "scratch"},
		{"s": "bastion", "t": "No boat leaves on a Sunday night. It is on no schedule I have."},
		{"s": "nico", "t": "It is a real bag. Not a weekend one. The kind you take when you are not coming back.", "cam": "close", "emote": "..."},
		{"s": "player", "t": "How long do I have?"},
		{"s": "nico", "t": "They were loading when I turned around. Minutes. I did not count them. Mika was not with me."},
		{"s": "nico", "t": "Go. I will get the Professor.", "do": "wave"},
		{"s": "lumen", "t": "Go. I will complain about the rain on the way.", "cam": "close"},
		{"campus": {"part": 2}},
		# ---- the pier, night
		{"scene": {"district": "academy", "inside": "", "pos": DOCK + Vector3(0.3, 0, -9.0), "yaw": 3.14, "tod": "night", "music": "duel_tense"},
			"title": "The Pier", "sub": "Night. The rain has not stopped. A boat with its lights on."},
		{"room": DOCK + Vector3(0, 0, -5.0), "r": 9.0},
		{"actor": "dante", "at": DOCK + Vector3(1.4, 0, -3.0), "face": 0.0},
		{"actor": "crane", "at": DOCK + Vector3(-1.5, 0, -3.2), "face": 0.0},
		{"actor": "lumen", "at": DOCK + Vector3(1.3, 0, -8.2), "face": "player", "spirit": true},
		{"s": "lumen", "t": "There. The end of the pier. Two of them and one umbrella. He is not standing under it.", "cam": "close"},
		{"s": "lumen", "t": "The boards are wet. Walk anyway.", "cam": "close"},
		{"cine": false},
		{"goal": "Reach Dante before the boat leaves", "at": DOCK + Vector3(0.2, 0, -3.2), "r": 1.8, "how": "The end of the pier. Dante is standing by the boat with a bag."},
		{"cine": true},
		{"actor": "dante", "at": DOCK + Vector3(1.4, 0, -3.0), "face": "player"},
		{"s": "dante", "t": "Of course it is you. The reserve. They could not even send a starter.", "cam": "low"},
		{"s": "player", "t": "Nobody sent me."},
		{"s": "dante", "t": "No. Nobody would have. Do you know what this island has asked me for since the first day? Win, Morel. Win it for Blue. Win it like your father.", "do": "chat", "cam": "close"},
		{"s": "dante", "t": "Nobody on this island ever asked me to stay. They asked me to win.", "cam": "close"},
		{"s": "dante", "t": "You beat me in a plaza, and the next morning people liked you more. I have never worked out how that is done.", "if": "rookie_champion"},
		{"s": "dante", "t": "I beat you in a plaza, and the next morning they were still sitting at your table. I have never worked out how that is done.", "if": "rookie_finalist"},
		{"cine": false},
		{"choice": [["Stay. This team is better with you in it.", "m_ch13_stay"], ["Go, then. You know where we are.", "m_ch13_go"]]},
		{"cine": true},
		{"wait": 1.4, "if": "m_ch13_stay"},
		{"s": "dante", "t": "You are the first one to say that.", "if": "m_ch13_stay", "cam": "close", "emote": "..."},
		{"s": "dante", "t": "You picked the wrong night.", "if": "m_ch13_stay", "cam": "low"},
		{"campus": {"bond": ["dante", 1]}, "if": "m_ch13_stay"},
		{"s": "dante", "t": "That is the first honest thing anybody has said to me here.", "if": "m_ch13_go", "cam": "close"},
		{"s": "dante", "t": "Tell Sato the seat is empty. She will fill it. She fills everything.", "cam": "low"},
		{"move": "dante", "to": DOCK + Vector3(0, 0, -0.9), "wait": true},
		{"s": "lumen", "t": "He looked back once. At the island, not at us. I am counting it anyway.", "cam": "close", "emote": "..."},
		{"gone": "dante"},
		{"merits": 20, "why": "You reached Dante in time"},
		# ---- the sponsor
		{"actor": "crane", "at": DOCK + Vector3(-1.5, 0, -3.2), "face": "player"},
		{"s": "crane", "t": "You walked out in the rain for a rival. Elena would have done exactly that. It is the first thing I noticed about you.", "cam": "close"},
		{"s": "crane", "t": "I will be brief. You are getting wet, and I am not.", "do": "chat"},
		{"s": "crane", "t": "The same offer. A scholarship. A deck with no weak card in it. And a seat that is not a bench.", "cam": "low"},
		{"s": "player", "t": "You already filled your boat tonight."},
		{"s": "crane", "t": "I always have room. That is all money really is. Room.", "cam": "close"},
		{"s": "crane", "t": "Let me tell you why I ask. I was a student here. In Red. The roof leaked then, too.", "do": "chat"},
		{"s": "crane", "t": "Elena Sato and I won the last League this island ever won. Together. On that same floor.", "cam": "close"},
		{"s": "crane", "t": "The prize was one professional seat. One, for the two of us. So we played for it.", "cam": "low"},
		{"s": "crane", "t": "She won. She was better that day. I have never said otherwise."},
		{"s": "player", "t": "And you never forgave her for it."},
		{"s": "crane", "t": "There was nothing to forgive. She won it. It is what she did with it. Two years later she gave the seat back and came here to teach in the worst dorm on the island.", "do": "chat"},
		{"s": "crane", "t": "I have spent ten years trying to understand that.", "cam": "close", "emote": "..."},
		{"s": "lumen", "t": "He says her first name like a card he still keeps in his deck.", "cam": "close"},
		{"cine": false},
		{"choice": [["I already have a team.", "m_no_team"], ["I would rather beat your school than join it.", "m_no_beat"], ["Ask me again when I have heard her side.", "m_no_sato"]]},
		{"cine": true},
		{"s": "crane", "t": "A team. She would have said that. Almost word for word.", "if": "m_no_team", "cam": "close"},
		{"s": "crane", "t": "Good. That was honest. I would much rather be fought than visited out of politeness.", "if": "m_no_beat", "cam": "close"},
		{"s": "crane", "t": "Her side. That is fair. Do ask her. I have only ever had mine.", "if": "m_no_sato", "cam": "close"},
		{"s": "crane", "t": "The offer does not expire. Mine never do.", "cam": "low"},
		{"s": "crane", "t": "Good night. Do get out of the rain. The League needs you in good health. I should know. I pay for the League.", "do": "wave"},
		{"move": "crane", "to": DOCK + Vector3(0, 0, -0.9), "wait": true},
		{"gone": "crane"},
		{"s": "lumen", "t": "He was kind the whole time. I kept waiting for the part where he stopped. There was no such part. That is what scares me.", "cam": "close", "emote": "..."},
		{"merits": 40, "why": "You said no to Silas Crane"},
		# ---- the Red kitchen, late
		{"scene": {"district": "academy", "inside": "dorm_red", "pos": RED + Vector3(0.4, 0, 4.6), "yaw": 0.0, "tod": "night", "music": "shop"},
			"title": "The Red Kitchen", "sub": "Late. Wet shoes by the door, and one light on."},
		{"actor": "sato", "at": RED + Vector3(-0.3, 0, 2.0), "face": "player"},
		{"actor": "bruno", "at": RED + Vector3(1.2, 0, 2.6), "face": "player"},
		{"actor": "nico", "at": RED + Vector3(2.6, 0, 3.4), "face": "sato"},
		{"actor": "mika", "at": RED + Vector3(-1.9, 0, 1.4), "face": "sato"},
		{"actor": "lumen", "at": RED + Vector3(1.8, 0, 4.4), "face": "player", "spirit": true},
		{"s": "bruno", "t": "Shoes off. Tea first. You look like the bottom of the ferry.", "cam": "low", "do": "chat"},
		{"s": "sato", "t": "Paz told me. I did not go to the pier. If I had gone, Morel would have left to spite me. He deserves to leave for his own reasons.", "cam": "close"},
		{"s": "player", "t": "He took the boat. And Crane told me about the last League."},
		{"s": "sato", "t": "He told you. He tells it well. He leaves out the part where I asked him to come with me.", "cam": "close"},
		{"s": "mika", "t": "Come with you where, Professor?", "emote": "?"},
		{"s": "lumen", "t": "There is a photograph under her hand. Old. Two red jackets in it. She has not let go of it since we came in.", "cam": "close"},
		{"s": "player", "t": "What is the rest of it?"},
		{"s": "sato", "t": "Mine is longer. Not tonight.", "cam": "close", "emote": "..."},
		{"s": "sato", "t": "Whatever you answered him, you are in this kitchen and not on his boat. Tonight that is the only answer I need.", "do": "chat"},
		{"campus": {"bond": ["sato", 1]}},
		{"s": "sato", "t": "I will say it once, so nobody has to guess. Morel took the scholarship. He is gone.", "cam": "low"},
		{"roster": {"title": "The League Team", "sub": "Tonight", "rows": [["Captain", "zane"], ["", "alexis"], ["", "player"], ["Strategist", "bastion"], ["Open seat", "Nobody yet"]], "out": [["Left", "dante"]]}},
		{"s": "mika", "t": "Four. We need five for the final.", "cam": "close"},
		{"s": "nico", "t": "He beat me in two turns on my second day. I wanted him gone for a whole term. Now he is, and I feel terrible. Nobody warned me.", "do": "scratch", "emote": "..."},
		{"s": "lumen", "t": "You asked him to stay. He heard it. People take a thing like that with them, even on boats.", "if": "m_ch13_stay", "cam": "close"},
		{"s": "lumen", "t": "You told him he knows where we are. He does. It is the island with the kitchen light on.", "if": "m_ch13_go", "cam": "close"},
		{"s": "bruno", "t": "Then somebody is going to have to be found. Eat.", "do": "stomp", "cam": "low"},
		{"remember": "dante_left"},
		{"merits": 40, "why": "The team, tonight"},
		{"s": "sato", "t": "Thursday. Practice. Four names and a gap. Go to bed, all of you."},
		# ---- night: your room
		{"scene": {"district": "academy", "inside": "yel_room_2", "pos": YROOM + Vector3(0.6, 0, 1.0), "yaw": 0.6, "tod": "night", "music": "shop"},
			"title": "Room 2", "sub": "The rain is still going."},
		{"actor": "lumen", "at": YROOM + Vector3(1.6, 0, 1.2), "face": "player", "spirit": true},
		{"s": "lumen", "t": "Two scholarships in one night. One taken, one not. I know which of you two I would rather live in a deck with.", "cam": "close"},
		{"s": "lumen", "t": "He said his offers never expire. I do not like things that never expire. Even I flicker.", "cam": "close"},
		{"s": "player", "t": "She asked him to come with her."},
		{"s": "lumen", "t": "And he heard something else. I wonder what. ...Sleep. Thursday has four names and a gap in it.", "cam": "wide", "emote": "..."},
		{"campus": {"sleep": true}},
		{"cine": false},
		{"end": "Chapter 13 complete", "unlock": "ac_ch14", "pay": 70, "wake": YROOM + Vector3(0.6, 0, 1.0),
