		{"gone": "dante"},
		{"s": "sato", "t": "Nobody goes after him tonight. Tonight he would hear it as an order. Go and eat.", "do": "chat"},
		{"s": "lumen", "t": "The sky is turning the color of that ship. I think the umbrella knows something.", "cam": "close", "emote": "..."},
		{"campus": {"part": 2}},
		# ---- night: your room
		{"scene": {"district": "academy", "inside": "yel_room_2", "pos": YROOM + Vector3(0.6, 0, 1.0), "yaw": 0.6, "tod": "night", "music": "shop"},
			"title": "Room 2", "sub": "Lights out. A new light at the end of the pier."},
		{"actor": "lumen", "at": YROOM + Vector3(1.6, 0, 1.2), "face": "player", "spirit": true},
		{"s": "lumen", "t": "First League match. First win. I have decided it was mostly me. I stood very close.", "cam": "close", "emote": "♪"},
		{"s": "lumen", "t": "The Wall said she would bring better questions. I believe her. She does not look like somebody who says things for fun.", "cam": "close"},
		{"s": "player", "t": "Was he watching? During the duel.", "emote": "?"},
		{"s": "lumen", "t": "The captain? Every turn. He thinks nobody saw. I am nobody. I saw.", "cam": "close"},
		{"s": "lumen", "t": "And the pin sat on that bench for the whole duel. Nobody sat next to it.", "cam": "close", "emote": "..."},
		{"s": "lumen", "t": "There is a light at the end of the pier. It was not there last night. Sleep. If the rain comes, I will count it for you.", "cam": "wide"},
