		{"s": "player", "t": "Write the thing you would not say in a meeting.", "if": "m_fest_octavia"},
		{"s": "octavia", "t": "That is most things. ...There. Do not read it.", "if": "m_fest_octavia", "do": "scratch"},
		{"s": "octavia", "t": "Things I was wrong about. Line three: that this night was something to supervise.", "if": "m_fest_octavia", "cam": "close"},
		{"s": "octavia", "t": "I have put the clipboard down. On a rock. If the wind takes it, I am told that is allowed tonight.", "if": "m_fest_octavia", "cam": "close", "emote": "♪"},
		{"campus": {"bond": ["octavia", 2]}, "if": "m_fest_octavia"},
		# with Jaden
		{"s": "jaden", "t": "Best seat on the island. Lie down. You see more of them from your back.", "if": "m_fest_jaden", "do": "wave"},
