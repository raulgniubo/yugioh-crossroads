		{"cine": false},
		{"choice": [["Nico. I need the noise.", "m_second_nico"], ["Mika. I need the numbers.", "m_second_mika"], ["Alexis. I need somebody who says it straight.", "m_second_alexis"], ["Octavia. I need somebody who has read the rules.", "m_second_octavia"]]},
