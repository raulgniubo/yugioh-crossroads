	"ac_ch12": [
		{"scene": {"district": "academy", "inside": "", "pos": DOCK + Vector3(0.3, 0, -9.0), "yaw": 3.14, "tod": "day", "music": "academy"},
			"chapter": "Chapter 12", "title": "First Match", "sub": "Saturday. A grey ship came in with the tide. Nobody on it waved."},
		{"campus": {"morning": true, "weekday": 5}},
		{"cine": true},
		{"room": DOCK + Vector3(0, 0, -5.0), "r": 9.0},
		{"actor": "irina", "at": DOCK + Vector3(0, 0, -2.0), "face": "player"},
		{"actor": "rurik", "at": DOCK + Vector3(0, 0, -0.9), "face": "player"},
		{"actor": "tova", "at": DOCK + Vector3(-1.3, 0, -1.0), "face": "player"},
		{"actor": "sheppard", "at": DOCK + Vector3(-1.5, 0, -3.2), "face": "irina"},
		{"actor": "zane", "at": DOCK + Vector3(1.4, 0, -3.0), "face": "irina"},
		{"actor": "sato", "at": DOCK + Vector3(1.3, 0, -8.2), "face": "irina"},
		{"actor": "lumen", "at": DOCK + Vector3(0.8, 0, -7.0), "face": "player", "spirit": true},
		{"shot": {"on": DOCK + Vector3(0, 0, -2.0), "look_h": 1.4, "ang": [2.6, 3.5], "d": [9.0, 6.0], "h": [3.2, 1.9], "t": 6.5},
			"vo": ["lumen", "A grey ship, grey coats, grey faces. I waved at all of them. I am invisible and I still took it personally."]},
		{"s": "sheppard", "t": "Captain Volkova. Duel Academy is glad to have Boreal on its pier. I hope the crossing was kind.", "do": "wave"},
		{"s": "irina", "t": "The sea was flat. We did not come for the sea.", "cam": "low"},
		{"s": "irina", "t": "Truesdale. I am told a professional beat you last week, in your own arena.", "cam": "close"},
		{"s": "irina", "t": "Good. I prefer my opponents already cracked. It saves me a turn."},
		{"s": "zane", "t": "He beat me. You are not him.", "cam": "low"},
		{"s": "zane", "t": "Bring the wall. I will be done before the tide turns.", "cam": "close"},
		{"s": "lumen", "t": "I felt that from here. The water around the pier just dropped two degrees.", "cam": "close", "emote": "..."},
		{"s": "irina", "t": "And you. You are the one in the notebook.", "cam": "close"},
		{"s": "player", "t": "The notebook stayed on the island."},
		{"s": "tova", "t": "The notebook stayed. I did not need it to remember. I count too.", "cam": "close"},
		{"s": "irina", "t": "Four pages about a reserve. I told her it was a waste of ink. She disagreed. She is rarely wrong, and I dislike it.", "do": "chat"},
		{"s": "lumen", "t": "Four pages there, forty in Bastion's file. You are the best documented bench in the League.", "cam": "close", "emote": "♪"},
		{"s": "sato", "t": "The arena at ten, Captain. Three duels. The order goes up when both teams are seated.", "do": "chat"},
		{"s": "irina", "t": "Boreal is always seated.", "cam": "low"},
		# ---- the voice of home matches
		{"actor": "nico", "at": DOCK + Vector3(-1.2, 0, -6.4), "face": "player", "from": DOCK + Vector3(-1.2, 0, -11.8), "run": true},
		{"s": "nico", "t": "Testing. Testing! Is this on? It is on. Everybody on this pier, I am on!", "do": "cheer", "cam": "wide"},
		{"s": "sheppard", "t": "Ah. Yes. After the Cup I made Mister Paz the official voice of our home matches.", "do": "chat"},
		{"s": "sheppard", "t": "I had forty letters asking for him and one against. The one was from Doctor Crowler.", "cam": "close", "emote": "♪"},
		{"s": "nico", "t": "Official. With a badge and a real microphone. I am not allowed to lose the cable. It is in writing.", "cam": "close"},
		{"s": "player", "t": "Do not lose the cable."},
		{"s": "nico", "t": "You told me to call the League. All of it. Here is the first piece.", "if": "m_ch7_league", "do": "wave"},
		{"s": "nico", "t": "From a seagull to a League match in seven weeks. The seagull would be proud.", "unless": "m_ch7_league", "do": "wave"},
		{"s": "irina", "t": "Your school has an announcer. Ours has a scoreboard. We find it says enough.", "cam": "low"},
		{"s": "nico", "t": "She did not even blink at me. Everybody blinks at me.", "emote": "..."},
		{"merits": 20, "why": "Boreal arrives"},
		# ---- the arena
		{"scene": {"district": "academy", "inside": "ac_hall", "pos": STAGE + Vector3(1.0, 0, 7.6), "yaw": 0.0, "tod": "day", "music": "duel_tense"},
			"title": "The League of Academies", "sub": "Duel Academy against Boreal Academy. Three duels. Two of them take the match."},
		{"room": STAGE, "r": 9.0},
		{"actor": "sato", "at": STAGE + Vector3(0.0, 0, 0.6), "face": "player"},
		{"actor": "sheppard", "at": STAGE + Vector3(-1.9, 0, 1.0), "face": "player"},
		{"actor": "crowler", "at": STAGE + Vector3(1.9, 0, 1.0), "face": "player"},
		{"actor": "nico", "at": STAGE + Vector3(2.0, 0, 2.8), "face": "player"},
		{"actor": "irina", "at": STAGE + Vector3(-2.0, 0, 2.8), "face": "sato"},
		{"actor": "rurik", "at": STAGE + Vector3(-1.3, 0, 6.8), "face": "sato"},
		{"actor": "tova", "at": STAGE + Vector3(-0.9, 0, 8.5), "face": "sato"},
		{"actor": "alexis", "at": STAGE + Vector3(4.6, 0, 3.6), "face": "sato"},
		{"actor": "bastion", "at": STAGE + Vector3(5.6, 0, 2.4), "face": "sato"},
		{"actor": "zane", "at": STAGE + Vector3(6.8, 0, 2.4), "face": "sato"},
		{"actor": "dante", "at": STAGE + Vector3(5.8, 0, 4.8), "face": "sato"},
		{"actor": "mika", "at": STAGE + Vector3(5.0, 0, 7.6), "face": "sato"},
		{"actor": "bruno", "at": STAGE + Vector3(6.5, 0, 6.0), "face": "sato"},
		{"actor": "lumen", "at": STAGE + Vector3(2.0, 0, 6.4), "face": "player", "spirit": true},
		{"s": "nico", "t": "Good morning, Duel Academy! The League of Academies, first match! In grey, from the north, with the meanest defense on any sea: Boreal Academy!", "do": "cheer", "cam": "wide"},
		{"s": "crowler", "t": "Mister Paz. Volume is not one of the rules of the League.", "do": "stomp"},
		{"s": "nico", "t": "It is not against them either, Doctor. Mika read all of them for me.", "cam": "close"},
		{"s": "sato", "t": "The order for Duel Academy. Rhodes plays first. Morel second. Truesdale last.", "cam": "low"},
		{"s": "dante", "t": "Second. Behind her, in front of him. I do not play second to anybody.", "cam": "low", "do": "stomp"},
		{"s": "sato", "t": "Then you do not play.", "cam": "close"},
		{"wait": 1.2},
		{"s": "dante", "t": "You would rather send a reserve into a League match than change one line on a sheet.", "cam": "close"},
		{"s": "sato", "t": "I would rather have three people who play where they are needed. You have just told me you are not one of them.", "cam": "low"},
		{"move": "dante", "to": STAGE + Vector3(3.6, 0, 6.0), "face": "player", "wait": true},
		{"s": "dante", "t": "The pin. I am leaving it on the bench. Give it to somebody who enjoys waiting in line.", "cam": "low"},
		{"move": "dante", "to": STAGE + Vector3(0.2, 0, 11.5)},
		{"s": "alexis", "t": "Dante. Dante! ...He left it. He actually left it on the bench.", "emote": "!"},
		{"gone": "dante"},
		{"s": "lumen", "t": "He put it down gently. People who do not care throw things.", "cam": "close", "emote": "..."},
		{"s": "sato", "t": "Truesdale, you are second. Reserve: you are third.", "cam": "low"},
		{"s": "zane", "t": "I will not need a third.", "cam": "low"},
		{"s": "sato", "t": "Then win, and we will find out.", "cam": "close"},
		{"s": "player", "t": "And if he does need one?", "emote": "?"},
		{"s": "sato", "t": "Then the bench has been watching. That is what I keep it for.", "do": "chat"},
		{"s": "bastion", "t": "For the file. This morning the odds of a reserve playing a League decider were two in a hundred. I am correcting the page now.", "do": "scratch"},
		{"roster": {"title": "Duel Academy against Boreal Academy", "sub": "Three duels", "rows": [["First duel", "alexis"], ["Second duel", "zane"], ["Third duel", "player"]]}},
		# ---- duel one: Alexis against Rurik
		{"s": "nico", "t": "First duel! For Boreal, a man who has not said one word since the pier: Rurik! For Duel Academy, first in every practice: Alexis Rhodes!", "do": "cheer", "cam": "low"},
		{"move": "rurik", "to": STAGE + Vector3(-1.9, 0, 4.9), "face": 1.57},
		{"move": "alexis", "to": STAGE + Vector3(2.4, 0, 4.9), "face": -1.57, "wait": true},
		{"clash": {"a": "rurik", "b": "alexis", "lp": [8000, 8000], "win": "a", "beats": [
			["b", "ETOILE CYBER", "I open. Etoile Cyber, straight at you. Seventeen hundred before you have even looked up.", 1700],
			["b", "CYBER BLADER", "He set two monsters and said nothing. Cyber Blader, by fusion. And now nothing of mine above level four is allowed to attack.", 0],
			["b", "CYBER TUTU", "Then I go under it. Cyber Tutu slips past your wall for a thousand.", 1000],
			["a", "GENERAL GRUNARD OF THE ICE BARRIER", "Enough.", 3400],
			["b", "MACHINE ANGEL RITUAL", "Five turns. I have thrown my whole deck at this wall. It has not moved one step.", 0],
			["a", "DEWLOREN, TIGER KING OF THE ICE BARRIER", "Done.", 4600]]}},
		{"s": "nico", "t": "Boreal takes the first duel. She hit that wall for five turns and I looked for dents. There are no dents.", "cam": "close", "emote": "..."},
		{"s": "lumen", "t": "He spoke twice. Enough, and done. For him I think that was shouting.", "cam": "close"},
		{"move": "rurik", "to": STAGE + Vector3(-1.3, 0, 6.8), "face": "sato"},
		{"move": "alexis", "to": STAGE + Vector3(4.6, 0, 3.6), "face": "zane", "wait": true},
		{"s": "alexis", "t": "They never attack first. They wait until you are tired of attacking. Zane, did you see that?", "cam": "close"},
		{"s": "zane", "t": "I do not get tired.", "cam": "low"},
		{"s": "sato", "t": "He was not watching. You were. What did you see?", "cam": "close"},
		{"s": "player", "t": "The wall only holds while somebody keeps hitting it."},
		{"s": "sato", "t": "Good. Keep that. You may need it in twenty minutes.", "do": "chat"},
		# ---- duel two: Zane against Tova
		{"s": "nico", "t": "Second duel! For Boreal, the visitor with the notebook: Tova Lindqvist! For Duel Academy, our captain. He asked me to keep it short. That was it.", "do": "cheer", "cam": "low"},
		{"move": "tova", "to": STAGE + Vector3(-1.9, 0, 4.9), "face": 1.57},
		{"move": "zane", "to": STAGE + Vector3(2.4, 0, 4.9), "face": -1.57, "wait": true},
		{"clash": {"a": "zane", "b": "tova", "lp": [8000, 8000], "win": "a", "beats": [
			["b", "CLOUDIAN - SHEEP CLOUD", "I have notes on you, Truesdale. The notebook was only the first copy.", 0],
			["a", "CYBER DRAGON", "Then you know this one.", 0],
			["a", "CYBER TWIN DRAGON", "And that it attacks twice.", 2800],
			["b", "CLOUDIAN - NIMBUSMAN", "Clouds do not die in battle. You are hitting fog, and my notes say you will keep hitting it.", 0],
			["a", "POWER BOND", "Your notes are from last week.", 0],
			["a", "CYBER END DRAGON", "Eight thousand. It goes through fog.", 5200]]}},
		{"s": "nico", "t": "One duel each! Four turns! I had a whole paragraph ready and he did not leave me room for it!", "do": "cheer", "cam": "wide"},
		{"move": "tova", "to": STAGE + Vector3(-0.9, 0, 8.5), "face": "irina"},
		{"move": "zane", "to": STAGE + Vector3(7.4, 0, 4.6), "face": 3.14, "wait": true},
		{"s": "alexis", "t": "That was clean, Zane. ...Zane.", "emote": "..."},
		{"s": "lumen", "t": "He walked past four people who wanted to say well done. Now he sits apart, eyes front. He won, and it looks exactly like when he lost.", "cam": "close", "emote": "..."},
		{"s": "tova", "t": "My notes on him were correct. They did not help.", "cam": "close"},
		{"s": "irina", "t": "Notes do not hold a door. Sit down. It is my turn to count.", "cam": "low"},
		{"merits": 30, "why": "You watched two duels from the bench"},
		# ---- duel three: you
		{"s": "nico", "t": "One each! It all comes down to the third duel! For Boreal: captain for four seasons, the Wall herself. Irina Volkova!", "do": "cheer", "cam": "low"},
		{"move": "irina", "to": STAGE + Vector3(-1.9, 0, 4.9), "face": "player", "wait": true},
		{"s": "nico", "t": "And for Duel Academy. Off the bench. Yellow jacket, red kitchen. I was told to stay neutral, and I am telling you now that I will not!", "do": "cheer", "cam": "wide"},
		{"s": "irina", "t": "I came to play your captain last. They send me the four pages instead. Very well. I read them on the ship.", "cam": "close"},
		{"s": "irina", "t": "A wall is only a question asked slowly. Take your time answering.", "cam": "low"},
		{"s": "player", "t": "I already heard it once this morning."},
		{"s": "lumen", "t": "You told the captain he would never need to look at the bench. So do not make him.", "if": "m_ch9_ready", "cam": "close"},
		{"s": "lumen", "t": "You told the captain that one day he would look at the bench. The bench is on the floor now. Let us see where his eyes go.", "if": "m_ch9_look", "cam": "close"},
		{"s": "bruno", "t": "A wall is a wall. You do not push it. You knock, and you wait for somebody inside to get hungry.", "cam": "low"},
		{"cine": false},
		{"goal": "Take your place for the deciding duel", "at": STAGE + Vector3(2.4, 0, 4.9), "r": 2.2, "how": "Irina Volkova, the Wall, is waiting on the arena floor. One duel each. This one decides the match."},
		{"duel": {"opponent": "irina", "opp_deck": "deck_ice_barrier", "deck_tier": "full", "difficulty": 2, "field": "academy", "boss": true,
			"rule": "The deciding duel of the first League match, against the captain of Boreal. Her deck gives nothing away. If you lose, the match is replayed."}},
