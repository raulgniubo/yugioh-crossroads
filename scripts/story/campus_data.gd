	"ac_ch14": [
		{"scene": {"district": "academy", "inside": "ac_hall", "pos": STAGE + Vector3(1.0, 0, 7.6), "yaw": 0.0, "tod": "day", "music": "academy"},
			"chapter": "Chapter 14", "title": "Without Dante", "sub": "Thursday practice. Four names and a gap."},
		{"campus": {"morning": true, "weekday": 3}},
