		{"roster": {"title": "The Pro League", "sub": "The Ladder, after two Saturdays", "rows": [["Title", "vera"], ["2", "milo"], ["3", "cassia"], ["4", "player"], ["5", "aster"], ["6", "petra"], ["7", "dov"], ["8", "ines"]], "out": [["Out", "bram"]]}},
		{"s": "official", "t": "Rank four. For the record, the box on your sheet still has a line through it. The next two ranks both keep a full corner.", "cam": "low"},
