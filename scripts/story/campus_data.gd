		{"s": "nico", "t": "RED TAKES THE FINAL ROUND! Two duels to one! Eleven years! ELEVEN! Somebody take this microphone away from me!", "do": "cheer", "cam": "wide"},
		{"s": "octavia", "t": "So that is behind.", "cam": "close", "emote": "..."},
