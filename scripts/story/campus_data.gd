		# ---- the cafe, eight o'clock
		{"scene": {"district": "newdomino", "inside": "nd_cafe", "pos": CAFE + Vector3(0.6, 0, 3.4), "yaw": 0.0, "tod": "night", "music": "shop"},
			"title": "Cafe at Eight", "sub": "The team dinner. Five chairs at one table, and one chair at another."},
		{"cine": true},
		{"actor": "zane", "at": CAFE + Vector3(-4.6, 0, -0.8), "face": 3.14},
		{"actor": "alexis", "at": CAFE + Vector3(-1.6, 0, 0.6), "face": "zane"},
		{"actor": "bastion", "at": CAFE + Vector3(1.5, 0, 1.7), "face": "player"},
		{"actor": "mika", "at": CAFE + Vector3(-0.2, 0, -1.4), "face": "player", "if": "m_train_mika"},
		{"actor": "octavia", "at": CAFE + Vector3(-0.2, 0, -1.4), "face": "player", "if": "m_train_octavia"},
		{"actor": "syrus", "at": CAFE + Vector3(-0.2, 0, -1.4), "face": "player", "if": "m_train_syrus"},
		{"actor": "nico", "at": CAFE + Vector3(2.6, 0, -1.2), "face": "player"},
		{"actor": "sato", "at": CAFE + Vector3(-0.7, 0, 4.3), "face": "player"},
		{"actor": "lumen", "at": CAFE + Vector3(1.8, 0, 2.8), "face": "player", "spirit": true},
		{"s": "alexis", "t": "Zane. Sit with us.", "cam": "close"},
		{"s": "zane", "t": "I am thinking."},
		{"s": "alexis", "t": "You can think at this table. People do it all the time. I have seen them.", "do": "chat"},
		{"wait": 1.0},
		{"s": "sato", "t": "He is two tables closer than last term.", "cam": "close"},
		{"s": "player", "t": "You measured?", "emote": "?"},
		{"s": "sato", "t": "I coach. I measure everything he will not say.", "cam": "close", "emote": "♪"},
		{"s": "nico", "t": "I put the cook's parcel on his table. He looked at it for a full minute. Then he ate it. All of it. Nobody say anything.", "cam": "close"},
		{"s": "mika", "t": "Eleven thousand people. I ran my results against the size of the crowd. It is a line, and it points down.", "if": "m_train_mika", "cam": "close"},
		{"s": "mika", "t": "At two hundred people I am four points worse in every hundred. At eleven thousand the line leaves the paper.", "if": "m_train_mika", "do": "scratch"},
		{"s": "mika", "t": "Nico. Say something. Not about the duel. The bread, the flags, anything. It works. I do not know why and I am not going to measure it.", "if": "m_train_mika", "emote": "..."},
		{"s": "octavia", "t": "I have never played away. The rules are the same. I checked. The room is not.", "if": "m_train_octavia", "cam": "close"},
		{"s": "octavia", "t": "At home I am the prefect. Here I am a second seat in a borrowed city. Nobody here has to listen to me.", "if": "m_train_octavia", "do": "chat"},
		{"s": "octavia", "t": "Things I was wrong about. That people listened to me for the rules. It may have been for the quiet.", "if": "m_train_octavia", "emote": "..."},
		{"s": "syrus", "t": "He is right there. Two tables away. Tomorrow he is on the bench. Behind me. Watching.", "if": "m_train_syrus", "cam": "close", "emote": "..."},
		{"s": "syrus", "t": "Last time he watched, I looked at him, and I lost. So I will not look. I will look at the cards.", "if": "m_train_syrus", "do": "scratch"},
		{"s": "syrus", "t": "What if he looks at me?", "if": "m_train_syrus", "emote": "?"},
		{"s": "alexis", "t": "The first away match is the worst one. Mine was. I lost it. I am still on this team.", "cam": "close"},
		{"s": "sato", "t": "Tomorrow somebody at this table loses a duel. Perhaps two of you. I did not bring you here to never lose. I brought three people to play as one.", "cam": "low", "do": "chat"},
		{"s": "bastion", "t": "The file on tomorrow. Brisa opens for them, Tano plays second, Brasa closes. He always closes. He likes the noise at its loudest.", "do": "chat"},
		{"s": "bastion", "t": "The notes in the margins are Octavia's. Her handwriting runs in straight lines. She corrected my grammar twice. She was right both times.", "unless": "m_train_octavia", "cam": "close"},
		{"s": "bastion", "t": "The notes in the margins are yours, Lenz. You corrected my grammar twice. You were right both times. I have filed it under grievances.", "if": "m_train_octavia", "cam": "close"},
		{"s": "bastion", "t": "One thing from page three, for the decider. Brasa burns you from his hand. Do not count his monsters. Count his cards."},
		{"s": "player", "t": "Count his cards. Understood."},
		{"s": "lumen", "t": "Six people, two tables. Last term it was one table and one lighthouse. I am counting it as progress.", "cam": "close"},
		{"s": "sato", "t": "Bed by ten. And walk straight to the hotel.", "cam": "low"},
		{"merits": 20, "why": "The team dinner"},
