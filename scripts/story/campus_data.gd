		{"s": "aster", "t": "Twice, now. I am going to need a longer recording.", "if": "aster_exhibition_won", "cam": "close"},
		{"s": "aster", "t": "And this time, send the recording to me.", "unless": "aster_exhibition_won", "cam": "close"},
