		{"actor": "zane", "at": STAGE + Vector3(7.4, 0, 4.6), "face": 3.14},
		{"actor": "alexis", "at": STAGE + Vector3(4.6, 0, 3.6), "face": "zane"},
		{"actor": "bastion", "at": STAGE + Vector3(5.6, 0, 2.4), "face": "player"},
		{"actor": "lumen", "at": STAGE + Vector3(2.0, 0, 6.4), "face": "player", "spirit": true},
		{"s": "alexis", "t": "Again. From the top. Bastion, you call the third seat. Zane, you close. ...Zane.", "do": "stomp"},
		{"s": "zane", "t": "I heard.", "cam": "low"},
		{"s": "lumen", "t": "Two words. That is his whole week so far. I am keeping count. It fits on two fingers.", "cam": "close", "emote": "..."},
		{"s": "alexis", "t": "I am running a practice for four people and one of them is a statue. Somebody else say something.", "cam": "close"},
		{"s": "bastion", "t": "I have something. It is not helpful.", "do": "scratch"},
		{"s": "sato", "t": "News first. Boreal played the Sun yesterday. Two duels to one, Boreal.", "cam": "low"},
		{"s": "sato", "t": "The Wall held. So we go to the Sun needing a team, and I have three and a half people.", "cam": "close"},
		{"s": "player", "t": "Which of us is the half?", "emote": "?"},
		{"s": "sato", "t": "Today? Take your pick.", "emote": "..."},
		{"s": "bastion", "t": "It may shortly be fewer. This arrived at breakfast. White paper. Rather good paper.", "do": "chat"},
		{"s": "alexis", "t": "Apex. He is writing to you now.", "emote": "!"},
