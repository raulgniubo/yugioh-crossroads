		# ---- the mainland: the south gate
		{"scene": {"district": "newdomino", "inside": "", "pos": CITY_GATE + Vector3(0.6, 0, 1.0), "yaw": 0.0, "tod": "sunset", "music": "academy"},
			"title": "The Mainland", "sub": "The city of the Academy of the Sun. Every window has an orange flag in it."},
		{"cine": true},
		{"room": CITY_GATE, "r": 8.0},
		{"actor": "sato", "at": CITY_GATE + Vector3(0.0, 0, -3.0), "face": "player"},
		{"actor": "alexis", "at": CITY_GATE + Vector3(-1.6, 0, -1.4), "face": "player"},
		{"actor": "nico", "at": CITY_GATE + Vector3(1.8, 0, -1.6), "face": "player"},
		{"actor": "bastion", "at": CITY_GATE + Vector3(-2.8, 0, -3.4), "face": "player"},
		{"actor": "mika", "at": CITY_GATE + Vector3(2.8, 0, -3.6), "face": "player", "if": "m_train_mika"},
		{"actor": "octavia", "at": CITY_GATE + Vector3(2.8, 0, -3.6), "face": "player", "if": "m_train_octavia"},
		{"actor": "syrus", "at": CITY_GATE + Vector3(2.8, 0, -3.6), "face": "player", "if": "m_train_syrus"},
		{"actor": "zane", "at": CITY_GATE + Vector3(0.0, 0, -6.0), "face": 3.14},
		{"actor": "lumen", "at": CITY_GATE + Vector3(1.8, 0, 0.4), "face": "player", "spirit": true},
		{"s": "nico", "t": "Land! Solid, flat, patriotic land. Every window has a flag in it. Even the pigeons look like they support the Sun.", "do": "cheer", "cam": "wide"},
		{"s": "mika", "t": "Four hundred and twelve flags on this street. All orange. I looked for a blue one, for morale. There is not one.", "if": "m_train_mika", "cam": "close"},
		{"s": "bastion", "t": "Four hundred and twelve flags on this street alone. I checked the figure twice. Mika would have checked it three times.", "unless": "m_train_mika", "do": "chat"},
		{"move": "zane", "to": CITY_GATE + Vector3(0.0, 0, -14.0)},
		{"s": "alexis", "t": "He is already walking. He has never had a free night. He does not know what one is for.", "cam": "close"},
		{"gone": "zane"},
		{"s": "sato", "t": "Free night. Cafe at eight. Do not duel anybody in orange.", "cam": "low"},
		{"wait": 0.8},
		{"s": "sato", "t": "You will anyway. Do not lose your temper when you do.", "cam": "close", "emote": "♪"},
		{"s": "lumen", "t": "Something is burning, in a good way. East, along the wall. Follow the smoke. I am right behind it.", "cam": "close", "do": "cheer"},
		{"actor": "leo", "at": MARKET + Vector3(0.0, 0, 0.0), "face": -1.57},
		{"actor": "customer", "as": "kid", "coat": Color("e8862a"), "at": MARKET + Vector3(1.0, 0, -1.6), "face": "leo"},
		{"cine": false},
		{"goal": "Find something to eat at the market (the food stalls, east of the gate)", "at": MARKET + Vector3(-2.4, 0, 0.6), "r": 2.5, "how": "The food stalls, east of the gate along the south wall. Somebody there is cooking for a queue."},
		# ---- the market
		{"scene": {"district": "newdomino", "inside": "", "pos": MARKET + Vector3(-2.4, 0, 0.6), "yaw": -1.57, "tod": "sunset", "music": "shop"},
			"title": "The Market", "sub": "One stall, one cook, one queue. Every order is shouted twice."},
		{"cine": true},
		{"room": MARKET, "r": 7.0},
		{"actor": "leo", "at": MARKET + Vector3(0.0, 0, 0.0), "face": "player"},
		{"actor": "customer", "as": "kid", "coat": Color("e8862a"), "at": MARKET + Vector3(1.0, 0, -1.6), "face": "leo"},
		{"actor": "nico", "at": MARKET + Vector3(-0.8, 0, 1.8), "face": "leo"},
		{"actor": "alexis", "at": MARKET + Vector3(-3.4, 0, 2.2), "face": "leo"},
		{"actor": "mika", "at": MARKET + Vector3(-3.8, 0, -0.8), "face": "leo", "if": "m_train_mika"},
		{"actor": "octavia", "at": MARKET + Vector3(-3.8, 0, -0.8), "face": "leo", "if": "m_train_octavia"},
		{"actor": "syrus", "at": MARKET + Vector3(-3.8, 0, -0.8), "face": "leo", "if": "m_train_syrus"},
		{"actor": "lumen", "at": MARKET + Vector3(-1.4, 0, -0.8), "face": "player", "spirit": true},
		{"s": "leo", "t": "Two with everything! One with nothing! Who orders nothing? You get everything too, it is decided!", "do": "cheer", "cam": "wide"},
		{"s": "leo", "t": "Blue jackets. The island! The island is standing in my queue!", "cam": "close", "emote": "!"},
		{"s": "leo", "t": "Sit! Nobody plays me hungry, it is not fair to me.", "cam": "low", "do": "wave"},
		{"s": "nico", "t": "That is Leo Brasa. That is their captain. Their captain is wearing an apron.", "cam": "close", "emote": "!"},
		{"s": "leo", "t": "Captain on Saturdays. Cook the other six days. It is my grandmother's stall. She says the League is a hobby.", "do": "chat"},
		{"s": "alexis", "t": "We can pay, you know."},
		{"s": "leo", "t": "You can try. She will chase you down the street. She is eighty and she is fast.", "cam": "close"},
		{"s": "leo", "t": "I heard there is a kitchen on your island. A red one, with a cook who feeds a whole dorm. Is it true?", "cam": "close", "emote": "?"},
		{"s": "player", "t": "Bruno. They call him Tank."},
		{"s": "leo", "t": "A cook called Tank. I love him already. Tell him a captain from the desert wants a recipe. Any recipe. I am not proud.", "do": "cheer"},
		{"s": "mika", "t": "This plate has four ingredients I cannot identify. I do not like not knowing. I like the plate.", "if": "m_train_mika", "cam": "close"},
		{"s": "octavia", "t": "Is this stall licensed? ...Do not answer. I have decided not to know.", "if": "m_train_octavia", "cam": "close"},
		{"s": "syrus", "t": "It is hot. It is very hot. I am fine. Is it supposed to be this hot? I am fine.", "if": "m_train_syrus", "emote": "!"},
		{"cine": false},
		{"choice": [["What is in this?", "ch17_what"], ["One more plate.", "ch17_more"]]},
		{"cine": true},
		{"s": "leo", "t": "Chili, lime, smoke, and one thing I will tell you the day you beat me. So, never! Ha!", "if": "ch17_what", "do": "cheer"},
		{"s": "leo", "t": "One more plate! Did you hear that, grandmother? The island has taste!", "if": "ch17_more", "do": "cheer"},
		{"s": "leo", "t": "Tomorrow I am going to burn you down. With love! Eat, eat, you are too thin to lose properly.", "cam": "low", "do": "chat"},
		{"s": "leo", "t": "And take this to whoever did not come. There is always one who does not come. Feed that one first.", "cam": "close"},
		{"s": "alexis", "t": "...That would be Zane. How did he know there was a Zane?", "emote": "?"},
		{"s": "lumen", "t": "I want to dislike him. I have tried twice. I cannot find the handle.", "cam": "close", "emote": "♪"},
		{"s": "nico", "t": "He is going to be impossible to boo."},
		{"s": "alexis", "t": "They do not boo here. They sing. It is worse.", "cam": "close"},
		{"campus": {"bond": ["leo", 1]}},
