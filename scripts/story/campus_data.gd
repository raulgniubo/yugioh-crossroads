		{"actor": "lumen", "at": STADIUM + Vector3(1.8, 0, 3.8), "face": "player", "spirit": true},
		{"s": "leo", "t": "THROUGH THE GATE! The second one ever! I am turning the sign the right way up for this! No. It is glued. Next week!", "do": "cheer", "cam": "wide"},
		{"wait": 0.8},
		{"s": "aster", "t": "...Hm.", "cam": "close", "emote": "..."},
