	# ------------------------------------------------------------ the Midnight Circle (nights, the Old Dorm)
	# Optional. Masks, nicknames and a house rule on the door every night (CampusCircle). Rank one,
	# the Candle: four duels. {"circle_end": N} closes a night (0: the first visit, no duel).
	"circle_0": [
		{"scene": CIRCLE_SCENE, "title": "The Midnight Circle", "sub": "The Old Dorm. No jackets, no names."},
		{"cine": true},
		{"room": CELLAR, "r": 7.0},
		{"actor": "nico", "at": CELLAR + Vector3(-3.9, 0, -2.2), "face": "player", "plain": true, "mask": true, "called": "The Voice"},
		{"actor": "moth", "at": CELLAR + Vector3(0.0, 0, -3.0), "face": "player", "plain": true, "mask": true},
		{"actor": "mika", "at": CELLAR + Vector3(3.7, 0, 0.5), "face": "nico", "plain": true, "mask": true, "called": "Margin"},
		{"actor": "lumen", "at": CELLAR + Vector3(1.3, 0, 3.2), "face": "player", "spirit": true},
		{"s": "nico", "t": "Stop right there! Name, dorm and... no. No names. No dorms. That is the whole point. I keep forgetting my own script.", "do": "chat"},
		{"s": "lumen", "t": "That is Nico. In a mask. With a megaphone that does not work."},
		{"s": "nico", "t": "I am not Nico. I am the Voice of the Midnight Circle. Nico is asleep in Room Two. Ask anybody.", "cam": "close"},
		{"s": "nico", "t": "Here is how it goes. Jackets stay outside. Everybody wears a mask and picks a name. In here a Red and a Blue are the same thing: somebody with a deck.", "cam": "low"},
		{"s": "nico", "t": "Twelve duels to the top of the wall, in three ranks. Candle, Lantern, Midnight. You start with no candle at all."},
		{"s": "nico", "t": "And every night has a house rule, chalked on the door. One duel a night. Lose, and you come back another night. The wall is patient."},
		{"s": "nico", "t": "Nobody plays for cards or for merits. You play to get your name on that wall. So. What do I chalk?", "cam": "close"},
		{"choice": [["(Echo)", "nick_echo"], ["(Static)", "nick_static"], ["(Ash)", "nick_ash"]]},
		{"remember": "nick_echo", "if": "nick_echo"},
		{"remember": "nick_static", "if": "nick_static"},
		{"remember": "nick_ash", "if": "nick_ash"},
		{"mask_player": true},
		{"s": "lumen", "t": "Echo! You named yourself after my cards. I am not crying. Spirits do not cry. *bzzt*", "if": "nick_echo"},
		{"s": "lumen", "t": "Good name. Mysterious. I would have picked something with more sparkle, but nobody asked me.", "unless": "nick_echo"},
		{"s": "nico", "t": "Echo! Fresh chalk on the wall!", "if": "nick_echo"},
		{"s": "nico", "t": "Static! Fresh chalk on the wall!", "if": "nick_static"},
		{"s": "nico", "t": "Ash! Fresh chalk on the wall!", "if": "nick_ash"},
		{"s": "moth", "t": "A new mask. Good. I was getting tired of beating the same four people."},
		{"s": "nico", "t": "That is the Moth. Your first candle, whenever you are ready. Knock on the door.", "do": "chat"},
		{"circle_end": 0},
	],
