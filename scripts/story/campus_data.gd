		{"duel": {"opponent": "gus", "opp_deck": "deck_goblin", "deck_tier": "starter", "difficulty": 1, "class": "practice", "field": "academy", "lose_ok": true,
			"rule": "@class"}},
		{"scene": CLASS_SCENE},
		{"cine": true},
		{"room": LECT + Vector3(0, 0, -3.0), "r": 6.0},
		{"actor": "cls_a", "as": "yellow_student", "at": LECT + Vector3(-3.3, 0, -0.6), "face": PI, "sit": true},
		{"actor": "cls_b", "as": "red_student", "at": LECT + Vector3(2.6, 0, 0.9), "face": PI, "sit": true},
		{"actor": "cls_c", "as": "blue_student", "at": LECT + Vector3(-2.2, 0, 2.4), "face": PI, "sit": true},
		{"actor": "cls_d", "as": "red_student", "at": LECT + Vector3(4.4, 0, 2.4), "face": PI, "sit": true},
		{"actor": "cls_e", "as": "yellow_student", "at": LECT + Vector3(-4.6, 0, 0.9), "face": PI, "sit": true},
		{"actor": "sato", "at": LECT + Vector3(-0.8, 0, -4.9), "face": "player"},
		{"actor": "gus", "at": LECT + Vector3(3.9, 0, -4.3), "face": "player"},
		{"actor": "mika", "at": LECT + Vector3(-4.4, 0, -2.4), "face": "sato"},
		{"actor": "lumen", "at": LECT + Vector3(1.0, 0, 3.4), "face": "player", "spirit": true},
		{"class_check": "practice"},
		{"s": "sato", "t": "Won, and the way I asked. That is the whole lesson. Sit down.", "if": "met", "cam": "close"},
		{"s": "sato", "t": "You won. Not the way I asked. Two stars, and you know which one is missing.", "if": "won", "unless": "met", "cam": "close"},
		{"s": "sato", "t": "Lost. Good. Now you know something you did not know this morning. Next week.", "if": "lost", "cam": "close"},
