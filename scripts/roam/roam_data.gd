		"npcs": [
			{"id": "dawn_satellite", "char": "", "model": "duelist_m15", "name": "The First Shift", "color": Color("ffb86b"), "pos": Vector3(20.0, 0, -15.0), "face": -2.2, "hours": [5, 10], "aloof": true,
				"lines": ["The good scrap comes in on the night barge. If you are not here by sunup, somebody else has it.", "I found a card in the pile once. Just the once. I have been early every day since."],
				"duel": {"deck": "crow", "difficulty": 2, "intro": "Winner gets first pick of the pile."}},
			{"id": "night_satellite", "char": "", "model": "duelist_m16", "name": "The Scrap King", "color": Color("ff8a3a"), "pos": Vector3(4.6, 0, 33.0), "face": 3.4, "night": true, "aloof": true,
				"lines": ["Daytime is for fixing. Night is for finding out what the fix was worth.", "Lose, and I keep a card. Win, and you keep one of mine. Fair?", "Some nights I play the Fabled. They like being thrown away. Most things down here do."],
				"duel": {"deck": "deck_scrap", "decks": ["deck_scrap", "deck_fabled"], "intros": {"deck_scrap": "Everything here was thrown away once. Watch what it does now.", "deck_fabled": "Throw away your hand. It's the only way to win down here."}, "difficulty": 3, "intro": "Everything here was thrown away once. Watch what it does now.", "rare": true}},
			{"id": "yusei", "char": "yusei", "pos": Vector3(-8, 0, 11), "face": 0.4,
				"lines": ["This runner was scrap a month ago. Now she flies.", "You duel? Then let's ride. On foot will do today."],
				"duel": {"deck": "yusei", "difficulty": 2, "intro": "Let's rev it up!"}},
			{"id": "crow", "char": "crow", "pos": Vector3(17, 0, 11.5), "face": -1.9,
				"lines": ["Best noodles in Satellite, and I only deliver to friends.", "Beat my Blackwings and the next bowl's on me."],
				"duel": {"deck": "crow", "difficulty": 1, "intro": "Blackwings, take to the sky!"}},
			{"id": "kalin", "char": "kalin", "pos": Vector3(-13, 0, -22), "face": 0.5,
				"lines": ["...A duelist with a full hand has not learned to be satisfied.", "Let me teach you the Handless Combo."],
				"duel": {"deck": "kalin", "difficulty": 2, "intro": "Satisfy me!"}},
			{"id": "sat_vendor", "char": "", "model": "shopkeeper", "name": "Card Dealer", "color": Color("ffd166"), "pos": Vector3(21.5, 0, -14), "face": -2.6, "shop": true,
				"lines": ["Scrap, spare parts and booster packs. Guess which one sells.", "Packs, deck building, or switching decks?"]},
			{"id": "sat_kid", "char": "", "model": "street_duelist", "name": "Satellite Kid", "color": Color("ff8a3a"), "pos": Vector3(4, 0, 22), "face": 3.0,
				"lines": ["One day I'm gonna build a runner just like Yusei's!", "Until then I build my deck out of toys. A phone, a radio, a skateboard. Duel me!"],
				"duel": {"deck": "deck_morphtronic", "difficulty": 0, "intro": "Riding duel! Uh, standing duel! Toys, go!"}},
			{"id": "sat_mech", "char": "", "model": "office_worker", "name": "Mechanic", "color": Color("9fb4c8"), "pos": Vector3(-16, 0, 14.5), "face": 0.9,
				"lines": ["Speed Counters, Speed Spells... riding duels are a different sport.", "The track isn't open yet. Soon.", "Every part in my deck came off a scrap heap. Every single one still works."],
				"duel": {"deck": "deck_synchron", "difficulty": 2, "intro": "I build runners out of junk. Decks too. Let's go."}},
		],
	},
