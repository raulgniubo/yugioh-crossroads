		"npcs": [
			{"id": "dawn_newdomino", "char": "", "model": "office_worker", "name": "The Opening Bell", "color": Color("ffb86b"), "pos": Vector3(6.0, 0, 36.0), "face": 3.0, "hours": [5, 10], "aloof": true,
				"lines": ["The ring is empty for one hour after sunrise. One. I come down from the Tops just to hear it.", "At ten my day starts and I stop being interesting. You have until ten."],
				"duel": {"deck": "jack", "difficulty": 2, "intro": "Before the market opens."}},
			{"id": "night_newdomino", "char": "", "model": "stylish_woman", "name": "The Ring Phantom", "color": Color("2de2e6"), "pos": Vector3(-4.6, 0, 13.6), "face": 0.3, "night": true, "aloof": true,
				"lines": ["Up there they race in the dark. Down here I wait for whoever is brave enough to walk.", "Standing still is harder than it looks. Show me."],
				"duel": {"deck": "deck_ice_barrier", "difficulty": 3, "intro": "Cold out tonight. It gets colder.", "rare": true}},
			{"id": "jack", "char": "jack", "pos": Vector3(3.5, 0, -27.5), "face": 0.3,
				"lines": ["There is only one King, and you are looking at him.", "Entertain me, challenger."],
				"duel": {"deck": "jack", "difficulty": 2, "intro": "Bow before the King!"}},
			{"id": "akiza", "char": "akiza", "pos": Vector3(33.5, 0, -2.0), "face": -1.6,
				"lines": ["People used to run from my duels.", "You're still standing there. Good."],
				"duel": {"deck": "akiza", "difficulty": 2, "intro": "Bloom, Black Rose!"}},
			{"id": "nd_officer", "char": "", "model": "duelist_m13", "name": "Security Officer", "color": Color("3a86ff"), "pos": Vector3(-33.5, 0, -4.5), "face": 1.4,
				"lines": ["Sector Security. Keep your runner under the limit and your deck out of trouble.", "Six of us on every shift, and each one covers the next. My deck works the same way.", "Off duty I build clockwork. The Karakuri never stop moving."],
				"duel": {"deck": "deck_six_samurai", "decks": ["deck_six_samurai", "deck_karakuri"], "intros": {"deck_six_samurai": "By the book, all six of us!", "deck_karakuri": "Wind it up and watch it march."}, "difficulty": 2, "intro": "By the book, all six of us!"}},
			{"id": "nd_chief", "char": "", "model": "office_worker", "name": "Security Chief", "color": Color("7cc4ff"), "pos": Vector3(-33.0, 0, 8.5), "face": 1.8,
				"lines": ["The highway is the only road between here and Satellite. We watch every meter of it.", "My squad duels with swords. Every one of them brings a friend. Think you can keep up?"],
				"duel": {"deck": "deck_x_saber", "difficulty": 2, "intro": "Draw your blade. Security does not lose."}},
			{"id": "nd_mc", "char": "", "model": "duelist_m3", "name": "Stadium MC", "color": Color("ffd166"), "pos": Vector3(-4.5, 0, -27.0), "face": 0.2,
				"lines": ["Laaadies and gentlemen! The Fortune Cup qualifiers are open to every duelist in New Domino!", "The King himself is waiting by the doors. Beat him and the crowd will never forget your name.", "Between announcements I warm up the crowd with a duel. Gods of the north, live on stage!"],
				"duel": {"deck": "deck_nordic", "difficulty": 2, "intro": "Laaadies and gentlemen! A surprise match!"}},
			{"id": "nd_fan", "char": "", "model": "student_girl", "name": "Stadium Fan", "color": Color("ff5a7a"), "pos": Vector3(9.0, 0, -22.0), "face": -0.5,
				"lines": ["I have a ticket for every one of Jack's duels. Every. One.", "You duel too? Show me. My riders come with their own dragons. If you're boring I'm leaving.", "When the wind's right I bring the Gusto. They ride the same currents as the runners."],
				"duel": {"deck": "deck_dragunity", "decks": ["deck_dragunity", "deck_gusto"], "intros": {"deck_dragunity": "Don't be boring! Riders, mount up!", "deck_gusto": "Feel that breeze? That's my deck coming."}, "difficulty": 1, "intro": "Don't be boring! Riders, mount up!"}},
			{"id": "nd_resident", "char": "", "model": "stylish_woman", "name": "Tops Resident", "color": Color("f2e2b0"), "pos": Vector3(30.5, 0, 6.0), "face": -1.7,
				"lines": ["The view from the Tops is lovely. You can see all the way to Satellite. Not that anyone looks.", "My building has a duel field on the roof. Naturally."],
				"duel": {"deck": "deck_lightsworn", "difficulty": 2, "intro": "Up here the light is brighter. You'll see."}},
			{"id": "nd_clerk", "char": "", "model": "shopkeeper", "name": "Card Shop Clerk", "color": Color("ffd166"), "pos": Vector3(30.5, 0, 28.0), "face": -1.57, "shop": true,
				"lines": ["Welcome! Synchro support is our best seller. Tuners fly off the shelf.", "Packs, deck building, or switching decks?"]},
			{"id": "nd_rider", "char": "", "model": "street_duelist", "name": "Runner Mechanic", "color": Color("ff8a3a"), "pos": Vector3(-5.5, 0, 44.5), "face": 0.6,
				"lines": ["The gate behind me puts you straight onto the highway ring. Satellite is one exit down.", "There's a race flag at the start line. First across after a full lap takes the pot.", "I build my deck like I build engines. Break a part, a better one drops in."],
				"duel": {"deck": "deck_tg", "difficulty": 2, "intro": "Engine's warm. Let's see what yours can do."}},
			{"id": "nd_cafe", "char": "", "model": "duelist_f1", "name": "Cafe Regular", "color": Color("ff8ac0"), "pos": Vector3(-18.5, 0, 31.0), "face": 1.2,
				"lines": ["Three coffees and I still can't beat my own deck in a mirror match.", "I grow the beans myself, and the deck too. Help me test it?", "Some days I read fortunes instead. The Ladies are always right in the end."],
				"duel": {"deck": "deck_naturia", "decks": ["deck_naturia", "deck_fortune_lady"], "intros": {"deck_naturia": "Fresh from the garden. Espresso speed!", "deck_fortune_lady": "Shall I read your fortune? It says you lose."}, "difficulty": 2, "intro": "Fresh from the garden. Espresso speed!"}},
			{"id": "nd_rep", "char": "", "model": "stylish_woman", "name": "Showcase Rep", "color": Color("ff8a3a"), "pos": Vector3(-29.0, 0, -9.6), "face": 0.0,
				"lines": ["Welcome to the Duel Runner Showcase. Please don't touch the paint.", "The red one tops out faster than Security's pursuit runners. Officially, I never said that.", "Our partners build machines that drive themselves now. I duel with them on my breaks."],
				"duel": {"deck": "deck_meklord", "difficulty": 2, "intro": "Our newest model has no driver at all. Care for a test run?"}},
			{"id": "nd_collector", "char": "", "model": "duelist_m18", "name": "Runner Collector", "color": Color("2de2e6"), "pos": Vector3(-21.0, 0, -11.2), "face": -0.9,
				"lines": ["I collect runner parts. Engines, mostly. The older the better.", "My deck is built the same way: spare parts from every element, one controller to run them."],
				"duel": {"deck": "deck_genex", "difficulty": 2, "intro": "Every part has a job. Watch them work."}},
			{"id": "nd_cook", "char": "", "model": "duelist_m15", "name": "Market Cook", "color": Color("ff7a5a"), "pos": Vector3(23.6, 0, 37.6), "face": 3.0,
				"lines": ["Best takoyaki this side of the Daimon Area!", "Beat me in a duel and the next round's on the house."],
				"duel": {"deck": "crow", "difficulty": 1, "intro": "Order up!"}},
		],
