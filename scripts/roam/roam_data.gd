## The worlds you can travel between, in order, with a line each for the travel screen.
const WORLDS := [
	["domino", "Duel Monsters", "Downtown crossroads, Kame Game, KaibaCorp Tower.", Color("c08cff")],
	["academy", "GX", "Academy Island: main building, three dorms, lighthouse.", Color("ff4d5e")],
	["satellite", "5D's", "The Satellite junkyard, runner garage and duel ring.", Color("ff8a3a")],
	["heartland", "ZEXAL", "Heartland Plaza under the tower.", Color("ffd23a")],
]


static func district(key: String) -> Dictionary:
	return DISTRICTS.get(key, DISTRICTS["domino"])
