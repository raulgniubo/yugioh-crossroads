		"npcs": [
			{"id": "dawn_heartland", "char": "", "model": "duelist_m1", "name": "The Balloon Man", "color": Color("ffb86b"), "pos": Vector3(1.2, 0, -8.4), "face": 0.4, "hours": [5, 10], "aloof": true,
				"lines": ["I fill the festival balloons before anybody is up. Four hundred of them. Then I set out the sweets stand.", "Duel me while the helium settles. My deck is all cake and it still bites. I am gone by ten.", "Some mornings the sea is calling. Then I deal the Mermails.", "Some mornings I open the toybox. Every toy does its trick once, then I wind it up again."],
				"duel": {"deck": "deck_madolche", "decks": ["deck_madolche", "deck_mermail", "deck_wind_up"], "intros": {"deck_madolche": "Tea is served. Up, up and away.", "deck_mermail": "The tide's coming in. Hope you can swim.", "deck_wind_up": "Wind them up and let them go!"}, "difficulty": 2, "intro": "Tea is served. Up, up and away."}},
			{"id": "night_heartland", "char": "", "model": "duelist_m12", "name": "The Neon Oracle", "color": Color("ff5ab4"), "pos": Vector3(6.0, 0, -24.0), "face": 0.2, "night": true, "aloof": true,
				"lines": ["The tower lights tell me who is coming. Tonight they said: someone with a little light of their own.", "My cards are older than the tower. Older than the city. Let us see if the lights were right.", "Some nights the stones stay quiet and the dolls talk instead.", "On the darkest nights I bring the Ghostricks. You can't hit what you can't see."],
				"duel": {"deck": "deck_chronomaly", "decks": ["deck_chronomaly", "deck_gimmick_puppet", "deck_ghostrick"], "intros": {"deck_chronomaly": "The stones already know how this ends.", "deck_gimmick_puppet": "My dolls were waiting up for you.", "deck_ghostrick": "Trick or treat? Trick. Always trick."}, "difficulty": 3, "intro": "The stones already know how this ends.", "rare": true}},
			{"id": "yuma", "char": "yuma", "pos": Vector3(-5, 0, 12), "face": 0.3,
				"lines": ["I'm feeling the flow! Wait, are you a duelist too?", "Then high-five the sky and let's duel!"],
				"duel": {"deck": "yuma", "difficulty": 1, "intro": "I'm feeling the flow!"}},
			{"id": "shark", "char": "shark", "pos": Vector3(19, 0, 4), "face": -1.6,
				"lines": ["Tch. Another fish that thinks it can swim with sharks.", "Fine. I'll take a bite."],
				"duel": {"deck": "shark", "difficulty": 2, "intro": "Sink into the depths!"}},
