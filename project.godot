; Engine configuration file.
; Yu-Gi-Oh! Crossroads - private fan project

config_version=5

[application]

config/name="Yu-Gi-Oh! Crossroads"
config/description="Private fan project. Not affiliated with Konami."
config/version="0.16.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="Crossroads"
boot_splash/bg_color=Color(0.02, 0.035, 0.06, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/core/settings.gd"
Profile="*res://scripts/core/profile.gd"
Cards="*res://scripts/core/card_db.gd"
Avatars="*res://scripts/core/avatars.gd"
Portraits="*res://scripts/core/portraits.gd"
Sfx="*res://scripts/core/sfx.gd"
Music="*res://scripts/core/music.gd"
Router="*res://scripts/core/router.gd"
Collection="*res://scripts/core/collection.gd"
Pad="*res://scripts/core/pad.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

ui_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
